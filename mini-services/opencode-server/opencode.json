{
  "server": {
    "port": 18790,
    "bind": "loopback"
  },
  "providers": {
    "nvidia": {
      "type": "openai-compatible",
      "baseURL": "https://integrate.api.nvidia.com/v1",
      "apiKey": "${NVIDIA_API_KEY_1}",
      "models": [
        "moonshotai/kimi-k3",
        "nvidia/nemotron-3-ultra-550b-a55b"
      ]
    }
  },
  "mcp": {
    "servers": {
      "knowledge-bridge": {
        "type": "http",
        "url": "http://127.0.0.1:18789",
        "tools": ["knowledge_search", "knowledge_graph", "knowledge_write", "web_search"]
      }
    }
  },
  "lsp": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"]
    }
  }
}
