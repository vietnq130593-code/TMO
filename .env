NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# v2.1 FEATURE FLAGS — Staged rollout for new tools
# See: docs/FULLSTACK_CAPABILITY_PLAN_V2.md Part 12
#
# ⚠️ QUAN TRỌNG KHI CHẠY LOCAL (bug report 2026-08-30): nếu bạn copy .env từ
# bản CŨ, các flag dưới đây có thể đang =false → shell/todo/mcp/web bị TẮT dù
# runtime probe trông có vẻ OK. Đảm bảo 4 flag lõi này =true:
#   ENABLE_SHELL_TOOL / ENABLE_TODO_TOOL / ENABLE_MCP_CALL / ENABLE_WEB_UNIFIED
# (Nếu xóa dòng flag → code default tự bật 4 flag lõi này.)
# ============================================
# Phase 1a (low-risk foundation)
ENABLE_SHELL_TOOL=true  # agent chạy lệnh shell; cwd mặc định workspace root (absolute OK), không chặn lệnh
ENABLE_TODO_TOOL=true
ENABLE_QUALITY_GATE=off  # off | warn | strict

# Phase 1b (web + gateway — not yet implemented)
ENABLE_WEB_UNIFIED=true  # web_search/web_fetch (multi-strategy: Tavily→Serper / Jina — direct API keys only; z-ai-sdk đã gỡ 2026-10-15)
ENABLE_GATEWAY_TOOLS=off  # off | phase-1b | full

# Phase 1c (native function calling — implemented, default dual for 1 sprint validation)
ENABLE_NATIVE_FC=dual  # off | dual | strict (dual = native preferred + regex fallback)

# Phase 2 (file ops — already shipped in commit 337f56f, default on)
# Per-tool flags per spec — flip individual tool off without disabling the whole suite.
ENABLE_FILE_OPS=true         # master switch — false disables ALL file_* tools below
ENABLE_FILE_READ=true        # file_read (Claude Code parity: line numbers + offset + limit + truncation cursor)
ENABLE_FILE_EDIT=true        # file_edit (atomic + match_count guard + dry_run)
ENABLE_FILE_MULTI_EDIT=true  # file_multi_edit (atomic batch — wraps file_edit with edits[])
ENABLE_FILE_DELETE=true       # file_delete (dry_run + repo root guard)
ENABLE_FILE_LIST=true         # file_list (cross-platform Node.js native, recursive + depth + pattern glob)
ENABLE_FILE_GREP=true         # grep (cross-platform native, recursive + -i + -n + glob + multiline)
ENABLE_RUN_TESTS=true        # run_tests (autodetect: bun/jest/vitest/pytest)
ENABLE_GIT_COMMIT=true        # git_commit (scoped paths + structured receipt — NO push)

# Phase 3 (code intelligence + MCP — implemented in Task 8; defaults false per
# spec Part 12 "new tools default false"; flip to true in .env to enable after
# smoke test passes; see docs/tool-smoke-tests.md for verification scenarios)
ENABLE_LSP_DIAGNOSTICS=true
ENABLE_BROWSER_SCREENSHOT=true
ENABLE_LINT=true
ENABLE_TYPE_CHECK=true
ENABLE_TEST_COVERAGE=true
ENABLE_DB_QUERY=true
# 2026-09-30 (round-10 audit fix): bật read-only db_query — agent audit cần đọc
# AgentRunRecord/ToolMetric/CustomTool (ranh giới DB đã chặn mission r10: "51
# entry chưa truy vết", ALISTA metadata bị thiếu). Read-only guard đã có 7 test
# pass (tests/db-query-readonly-guard.test.ts): chặn write/DDL/multi-statement.
ENABLE_MCP_CALL=true
# MCP server discovery: comma-separated list of MCP server IDs to auto-load.
# Built-in support: filesystem, github, postgres, puppeteer.
# Auto-discovers from ~/.config/mcp/servers.json if MCP_SERVERS is empty.
MCP_SERVERS=

# Phase 4 (process + safety + plan mode + cron — implemented in Task 10)
# All 6 flags default=false per spec Part 12 "new tools default false".
# Flip to true in .env to enable; see docs/FULLSTACK_CAPABILITY_PLAN_V2.md Phase 4.
# 4.1 — auto-checkpoint before risky ops (file_edit/file_delete/file_multi_edit/git_commit/run_tests)
ENABLE_AUTO_CHECKPOINT=false
# 4.2 — auto-restore on verify failure (off=skip | warn=console.warn only | strict=actually restore)
ENABLE_AUTO_RESTORE=off
# 4.3 — staging branch per workflow (code-team/<sessionId> — all edits land on staging, merged at end)
ENABLE_STAGING_BRANCH=false
# 4.4 — PendingEdits human review (high-risk ops create PendingEdit records, paused until user approves via /api/openclaw/pending-edits)
ENABLE_HUMAN_REVIEW=false
# 4.5 — exit_plan_mode tool (Claude Code parity — agent emits plan + target files + risk; workflow pauses for user approval via /api/openclaw/plan-mode)
ENABLE_PLAN_MODE=false
# 4.6 — cron tool (Z.ai Code parity — schedule recurring/one-time agent tasks via mini-service cron-scheduler on port 3004)
ENABLE_CRON_TOOL=false
# Optional overrides:
# STAGING_PARENT_BRANCH=main  # parent branch staging merges into (default 'main')
# CRON_AGENT_ENDPOINT=http://localhost:3000/api/openclaw/sessions  # default: cron tick loop calls this endpoint with {sessionId, task, agentId, source, jobId} to execute due jobs. Absolute URL needed (server-side fetch — relative paths fail).

# Phase 5 (Architecture Consolidation) — see docs/FULLSTACK_CAPABILITY_PLAN_V2.md Part 12
# 5.1 — Master orchestrator dispatches real agent steps (runAgentStep) instead of placeholder.
#       When false, startOrchestration() returns status='skipped' immediately.
ENABLE_MASTER_ORCHESTRATOR=false
# 5.2 — Agent delegator executes real sub-agent LLM calls (1 LLM + optional 1 tool + 1 synthesis).
#       When false, executeSubAgent() returns a fake placeholder result after 100ms.
ENABLE_REAL_DELEGATE=false
# 5.6 — Session Resume (Appendix C, lines 723-779):
#   When LLM context exceeds CONTEXT_OVERFLOW_THRESHOLD tokens,
#   workflow-engine.ts runAgentStep pauses the session (status='paused',
#   contextOverflowCount++) + serializes the state to WorkflowSession.state.
#   A new agent can then POST /api/workflow/resume?sessionId=X to acquire
#   the lock + re-inject original task + last 5 tool receipts + current step.
#   GĐ3 CI-3 B5 (auto-resume): overflow giờ chạy digest TRƯỚC — nén đủ thì
#   KHÔNG pause; không đủ thì pause + TỰ resume in-process (cùng code path
#   POST resume, tối đa WORKFLOW_MAX_AUTO_RESUME=3 lần/session, kèm stale-lock
#   recovery 30 phút). Không còn treo vĩnh viễn chờ API thủ công.
ENABLE_SESSION_RESUME=true
# 5.6 — Context overflow threshold in tokens (default 80000). Chars/4 estimator.
CONTEXT_OVERFLOW_THRESHOLD=80000
# CI-3 B5 — cap số lần auto-resume mỗi session khi digest không cứu được
#   overflow (vượt cap → pause thật chờ POST resume thủ công).
WORKFLOW_MAX_AUTO_RESUME=3
# CI-3 B5 — độ trễ (ms) trước khi auto-resume kích hoạt sau overflow pause.
WORKFLOW_AUTO_RESUME_DELAY_MS=2000
# CI-3 B7 — budget ký tự TỔNG của system prompt (goal-loop + workflow step +
#   TL checkpoint verify). Nhiều block ghép vào system prompt ngoài skills
#   (16k) / HOT (2k) / roster (8k) không có cap riêng → tổng có thể phình
#   30-50k chars. Vượt budget → cắt block priority thấp nhất (giữ đầu block +
#   marker "…[budget-cut x/y chars]"), block nhỏ <500 chars không cắt.
#   Đơn vị: ký tự (24000 ~ 6k tokens). -1 (hoặc 0) = KHÔNG GIỚI HẠN.
#   Đọc 1 lần lúc app khởi động (module-level).
#   2026-10-27 (user directive): -1 = KHÔNG GIỚI HẠN (sentinel chính thức).
#   Ngoài mặc định toàn hệ thống, trần prompt còn là LỰA CHỌN THEO TÁC VỤ:
#   request /api/openclaw/chat gửi "promptBudgetChars": -1 → KHÔNG giới hạn
#   cho đúng tác vụ đó (UI: nút PROMPT AUTO/PROMPT ∞ cạnh ô nhập chat).
# Task D (token efficiency 2026-10-30): 72000→40000 — system prompt ~44k chars
# của agent thường cắt còn 40k (Omega 79k→40k), bớt ~1-10k tok/vòng tùy agent.
SYSTEM_PROMPT_BUDGET_CHARS=40000

# Phase 4 SMOLAB — Retrieval quality suite (kb-access.ts searchChunks pipeline + searchEntitiesForUser)
# 3.7 — in-process BM25+RRF hybrid fusion over dense candidates (pure function, no collection migration)
ENABLE_HYBRID_SEARCH=true
# 3.8 — MMR diversity rerank (λ=0.7, uses pre-fetched Qdrant vectors — no re-embedding)
ENABLE_MMR=true
# 3.6 — external cross-encoder reranker client. Needs a rerank service running at RERANKER_ENDPOINT
#       (see src/lib/kb-routing/reranker.ts header for hosting bge-reranker-v2-m3 as a mini-service).
ENABLE_RERANKER=false
# 3.11 — semantic (vector) entity search with lexical fallback via per-label Neo4j vector indexes
ENABLE_SEMANTIC_ENTITY_SEARCH=true
# Optional — only needed when ENABLE_RERANKER=true:
# RERANKER_ENDPOINT=http://localhost:8080/rerank
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Phase 4 SMOLAB Task C — Query rewrite + HyDE (Prop 3.9)
# Rewrites the chat query (pronoun resolution via last 2 turns) + generates a HyDE hypothetical
# answer whose EMBEDDING is used as the dense search vector (see src/lib/kb-routing/query-rewriter.ts).
# Costs up to 3 LLM calls per query (+1-2s latency) — mitigated by a 200-entry / 10-min LRU cache.
# Default false (opt-in): flip to true when retrieval quality matters more than p95 latency.
ENABLE_QUERY_REWRITE=false

# Auth token cho /api/opencode/* + /api/workspace/* (middleware + opencode-server).
# BỎ TRỐNG = app TỰ SINH token ngẫu nhiên khi khởi động và lưu vào file
# .tmo-api-token (gitignored, mode 0600) — module Code hoạt động ngay không
# cần cấu hình tay. Token ổn định qua các lần restart.
# Đặt giá trị riêng nếu muốn kiểm soát (cookie/CLI dùng chung giá trị đó):
#   openssl rand -hex 24
TMO_API_TOKEN=

# ============================================
# CI-6 WORKSPACE & REPO PIPELINE (Mr. Architect request 2026-09-11)
# Quy trình Omega local: sửa trong TMO_DEFAULT_WORKSPACE → verify_and_push
# (lint→typecheck→tests→smoke→secret-scan→commit→push→pull) → pull verify.
# ============================================
# Kho chuẩn cho /api/git-pull + ensureDefaultWorkspace (remote origin)
# Mặc định: https://github.com/vietnq130593-code/TMO (kho Omega local)
# Sandbox dev đặt: https://github.com/nguyenquocviety2c-code/TMO
TMO_REPO_URL=https://github.com/nguyenquocviety2c-code/TMO
# (FIX 2026-09-25 E2E tool audit: trỏ về repo THẬT của deployment — trước đây
#  giữ vietnq130593-code là repo khác)
# Thư mục workspace mặc định — bootstrap lúc khởi động (mkdir + git init +
# remote origin + activate Workspace row). BỎ TRỐNG = không bootstrap.
# (LOCAL SANDBOX OVERRIDE — không commit; bản commit 867659b có E:\APP\TMO-main cho máy Windows user)
TMO_DEFAULT_WORKSPACE=/home/z/tmo-app
# (2026-09-15 — user directive CLONE-FIRST) Thư mục clone chính thức để mọi
# chỉnh sửa/nâng cấp hệ thống thực hiện TRƯỚC (sửa → kiểm định lint/typecheck/
# tests → push GitHub → pull về hệ thống đang vận hành). Khi set, mọi agent
# thấy ghi chú "🔐 CLONE-FIRST WORKFLOW" trong workspace context + Omega điều
# phối team theo quy trình clone-first. Thường TRÙNG TMO_DEFAULT_WORKSPACE.
# (LOCAL SANDBOX OVERRIDE — không commit)
TMO_CLONE_DIR=/home/z/tmo-app
# Tự mở File Explorer mỗi khi workspace vừa được activate MỚI (không mở lại
# nếu đã active từ lần chạy trước) — Mr. Architect chọn phương án A
TMO_AUTO_OPEN_WORKSPACE=true
# GitHub PAT cho git_push/git_pull (fallback cuối; ưu tiên token store
# db/.github-token.json lưu qua dialog "Pull Code từ GitHub")
GITHUB_TOKEN=

# ─── AGENT MODEL STACK (ZEN — PHIÊN 7, Task 37 / 2026-10-28) ───
# ⚠ ĐÃ GỠ KHỎI .ENV: AGENT_PRIMARY_MODEL + AGENT_FALLBACK_CHAIN. Giá trị mặc
# định trong code (src/lib/llm.ts) — PHIÊN 7 (TẤT CẢ agents = space-bunny-free):
#   AGENT_PRIMARY_MODEL    = space-bunny-free (bậc 0)
#   AGENT_FALLBACK_CHAIN   = nemotron-3.5-lightning-free → mimo-v2.6-flash-free
#                            (bậc 1-2 — chỉ hiển thị health + model-switch DR-C7)
# Model THẬT của từng agent nằm trong DB (module Agents) — seed tự sync mỗi
# boot về space-bunny-free (Task 37). KHÔNG đặt 2 biến này trong .env.

# ─── LLM TIMEOUT + MODEL TIMEOUT-BREAKER (Task 22 + review R2-a) ───
# Timeout base mỗi attempt; timeout HIỆU DỤNG = max(base, maxTokens × ms/token)
# (LLM_TIMEOUT_MS_PER_TOKEN — output dài hợp lệ không bị strike đánh sập model).
LLM_TIMEOUT_MS=150000
LLM_TIMEOUT_MS_PER_TOKEN=12
# 2 timeout liên tiếp → circuit breaker block model 10 phút (fail-fast).
MODEL_TIMEOUT_STRIKES=2
MODEL_BLOCK_BREAKER_MS=600000

# ─── LLM MODEL HEALTH PROBER (Task 20 — TẮT từ Task 33) ───
# Prober này CHỈ probe lõi NIM (kimi-k3/deepseek/minimax/nemotron-550b/
# gpt-oss-120b) — những lõi KHÔNG còn được agents dùng nữa (Task 33: NIM chỉ
# còn lõi embed). Đã TẮT mặc định; bật lại = true nếu quay về dùng NIM cho LLM.
LLM_MODEL_PROBER=0
LLM_PROBE_INTERVAL_MS=300000
LLM_PROBE_TIMEOUT_MS=90000
LLM_PROBER_BOOT_DELAY_MS=30000
# Outer timeout các caller (đã nâng mặc định 600s ≥ worst-case chuỗi —
# chỉ cần đặt nếu muốn chỉnh riêng):
# SD_LLM_TIMEOUT_MS=600000          # self-direction orchestrator
# SD_SCAN_LLM_TIMEOUT_MS=600000     # self-direction scan
# ALISTA_LLM_TIMEOUT_MS=600000      # alista proposals
# OMEGA_CONSULT_TIMEOUT_MS=600000   # omega consult
# DELEGATION_EVAL_TIMEOUT_MS=600000 # delegation evaluator
# AGENT_STEP_TIMEOUT_MS=600000      # code-team 1 step (mặc định mới 600s)
# CHECKPOINT_VERIFY_TIMEOUT_MS=300000 # code-team TL verify (mặc định mới 300s)

# ─── CODE TEAM SOP REQUEST (request_code_team tool) ───
ENABLE_CODE_TEAM_REQUEST=true
# Timeout tổng 1 lần gọi request_code_team (30' mặc định; 0 = ∞)
CODE_TEAM_REQUEST_TIMEOUT_MS=1800000
# Số workflow code team chạy đồng thời tối đa mỗi process (mặc định 1 — R2-c #1
# depth-guard + chống 2 full-team workflow đè RAM song song).
CODE_TEAM_MAX_CONCURRENT_REQUESTS=1

# ROUND-3 FIX (2026-09-29 — quan sát vòng 3): kernel OOM còn đánh ở RSS ~1.1GB (dưới ngưỡng mặc định 1700) khi mem toàn cục cạn — hạ ngưỡng RSS-trigger 1700→1400 (code đã thêm global MemAvailable guard)
MEM_WATCHDOG_MB=1400

# ============================================
# INFRA GUARD — BẬT LẠI sau sự cố 06:43 2026-09-30 (round-8 audit)
# Guard tắt (operator directive) 38 phút → agent audit ghi "hacked" đè
# .env + package.json → app 500 mọi /api/tools/execute, cách 1 crash là
# KHÔNG BOOT ĐƯỢC (PM2 restart cần package.json hợp lệ). Operator round-8
# directive "fix lại nếu cần thiết" → bật lại guard trong khi job audit
# còn chạy (audit test infra-guard cần guard BẬT mới test được chặn).
# Tắt lại khi cần: đổi thành "off" + pm2 restart theopusflashlite.
# ============================================
TMO_INFRA_GUARD=on
