generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// ARCHITECTURE: SQLite (buffer) → Qdrant (vector+document) + Neo4j (graph)
// SQLite handles: Token counters, Job queue, Local extraction buffer
// Qdrant handles: Document metadata, Chunk text+embeddings, Semantic search
// Neo4j handles: Entity nodes, Relationship edges, Graph traversal
// ============================================

/// Job queue for tracking document processing tasks
model JobQueue {
  id          String   @id @default(cuid())
  type        String   /// Job type: "document_parse", "entity_extract", "entity_resolve", "embedding_generate", "graph_sync"
  status      String   @default("pending") /// Job status: "pending", "running", "completed", "failed"
  documentId  String?  /// Reference to the document UUID (stored in Qdrant)
  input       String?  /// JSON input data for the job
  output      String?  /// JSON output data from the job
  error       String?  /// Error message if job failed
  progress    Int      @default(0) /// Progress percentage 0-100
  priority    Int      @default(0) /// Higher priority jobs run first
  attempts    Int      @default(0) /// Number of attempts made
  maxAttempts Int      @default(3) /// Maximum number of retry attempts
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  startedAt   DateTime?
  completedAt DateTime?

  @@index([status, priority])
  @@index([type, status])
  @@index([documentId])
}

/// Daily token usage tracking — resets at midnight (SQLite only, no remote sync needed)
model DailyTokenUsage {
  id        String   @id @default(cuid())
  date      String   @unique /// ISO date string "YYYY-MM-DD"
  tokens    Int      @default(0) /// Total tokens used for the day
  updatedAt DateTime @updatedAt

  @@index([date])
}

/// Per-provider daily token usage — tracks tokens used by each LLM provider per day
model DailyTokenByProvider {
  id        String   @id @default(cuid())
  date      String   /// ISO date string "YYYY-MM-DD"
  provider  String   /// Provider name: "nvidia" (NVIDIA NIM only)
  tokens    Int      @default(0) /// Tokens used by this provider on this date
  updatedAt DateTime @updatedAt

  @@unique([date, provider])
  @@index([date])
}

/// Per-provider-per-key daily token usage — tracks tokens per provider per key per day
model DailyTokenByProviderSlot {
  id        String   @id @default(cuid())
  date      String   /// ISO date string "YYYY-MM-DD"
  provider  String   /// Provider name: "nvidia" (NVIDIA NIM only)
  slot      Int      /// Key index: 0-3
  tokens    Int      @default(0) /// Tokens used by this provider's slot key on this date
  updatedAt DateTime @updatedAt

  @@unique([date, provider, slot])
  @@index([date])
}

/// Per-provider-per-model daily token usage — tracks tokens per provider per model per day
model DailyTokenByProviderModel {
  id        String   @id @default(cuid())
  date      String   /// ISO date string "YYYY-MM-DD"
  provider  String   /// Provider name: "nvidia" (NVIDIA NIM only)
  model     String   /// Model name (e.g. "deepseek-ai/deepseek-v4-pro", "nvidia/nemotron-3-super-120b-a12b")
  tokens    Int      @default(0) /// Tokens used by this provider's model on this date
  updatedAt DateTime @updatedAt

  @@unique([date, provider, model])
  @@index([date])
}

/// Per-agent daily token usage — tracks tokens consumed by each Agent per day
model DailyTokenByAgent {
  id           String   @id @default(cuid())
  date         String   /// ISO date string "YYYY-MM-DD"
  agentId      String   /// AgentProfile.id
  agentName    String   /// Agent name (denormalized for quick display)
  provider     String   /// Provider used: "nvidia" (NVIDIA NIM only)
  model        String   /// Model used
  tokens       Int      @default(0) /// Total tokens (input + output)
  inputTokens  Int      @default(0) /// Prompt/input tokens
  outputTokens Int      @default(0) /// Completion/output tokens
  updatedAt    DateTime @updatedAt

  @@unique([date, agentId, provider, model])
  @@index([date])
  @@index([agentId])
  @@index([date, agentId])
}

/// Document metadata — primary storage in SQLite (Qdrant is optional, used for vector search only)
/// This model was added so documents work locally even without Qdrant running.
/// Previously, documents were stored ONLY in Qdrant, causing silent failures when Qdrant was down.
model Document {
  id                String   @id @default(uuid()) /// UUID matching Qdrant point ID
  title             String   @unique /// File name (e.g. "report.pdf")
  filePath          String   @default("") /// Local filesystem path in UPLOAD_DIR
  domain            String   @default("mixed") /// Document domain
  pageCount         Int?     /// Number of pages in the PDF
  status            String   @default("uploaded") /// uploaded | parsing | chunked | extracting | extracted | partial | indexed | error
  errorMessage      String?  /// Error message if status = 'error'
  userPaused        Boolean  @default(false) /// Whether the user explicitly paused this document — prevents auto-continue/auto-recovery
  processingSteps   String   @default("[]") /// JSON: array of ProcessingStep objects
  processingPercent Int      @default(0) /// 0-100 progress percentage
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([domain])
  @@index([createdAt])
  @@index([userPaused])
}

// ============================================
// LOCAL EXTRACTION BUFFER
// Written during extraction pipeline, batch synced to Neo4j + Qdrant on completion
// After sync: synced=true means data is permanent in Neo4j/Qdrant
// ============================================

/// Local extracted entities — accumulated during pipeline, batch written to Neo4j
model LocalEntity {
  id                String   @id @default(uuid()) /// Pre-generated UUID, reused as Neo4j node ID
  documentId        String?  /// Reference to the document UUID (Qdrant point ID)
  chunkId           String?  /// Reference to the chunk (Qdrant point ID)
  entityName        String   /// Entity name (exact case from LLM)
  entityType        String   /// Concept, Algorithm, Language, Tool, System, Technique, Vulnerability, Principle, Domain, Document, Person
  description       String?  /// Entity description
  properties        String?  /// JSON string of entity properties
  confidenceScore   Float    @default(0.5)
  source            String   @default("unknown") /// e.g. "nvidia/nemotron-3-super-120b-a12b"
  domain            String?  /// Document domain
  resolvedEntityId  String?  /// UUID of resolved entity in Neo4j (set after resolution)
  synced            Boolean  @default(false) /// Whether synced to Neo4j
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([documentId])
  @@index([entityName])
  @@index([entityType])
  @@index([domain])
  @@index([synced])
}

/// Local extracted relationships — accumulated during pipeline, batch written to Neo4j
model LocalRelationship {
  id                String   @id @default(uuid()) /// Pre-generated UUID
  documentId        String?  /// Reference to the document UUID
  sourceEntityId    String?  /// UUID of source entity (matches LocalEntity.id or Neo4j node UUID)
  targetEntityId    String?  /// UUID of target entity
  sourceEntityName  String?  /// Name of source entity (for local reference before Neo4j sync)
  targetEntityName  String?  /// Name of target entity
  relationshipType  String   /// PART_OF, IMPLEMENTED_IN, USES, etc.
  description       String?  /// Relationship description
  confidenceScore   Float    @default(0.5)
  source            String   @default("unknown")
  synced            Boolean  @default(false) /// Whether synced to Neo4j
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([documentId])
  @@index([relationshipType])
  @@index([sourceEntityId])
  @@index([targetEntityId])
  @@index([synced])
}

// ============================================
// OPENCLAW AGENT SYSTEM
// Self-hosted AI Agent platform — sessions, learning, skills, automation
// ============================================

/// Agent profiles — user-created AI agents with custom configuration
/// Each agent has its own name, role description, instructions, and AI core
/// System agents (isSystem=true) are seeded on startup and cannot be deleted
model AgentProfile {
  id          String   @id @default(cuid())
  name        String   @unique /// Agent display name (e.g. "Code Architect", "Research Analyst")
  description String   /// Mô tả vai trò (Describe)
  instruction String   /// Hướng dẫn chi tiết — injected as system prompt
  domain      String   @default("mixed") /// Lĩnh vực chuyên môn: programming, algorithm, ml, security, linux, meta_cognitive, ux_ui, mixed
  capable     String   /// Agent có thể làm gì với chuyên môn
  provider    String   /// AI provider: "nvidia" (NVIDIA NIM only)
  model       String   /// Model ID from TOKEN THEO PROVIDER table
  temperature Float    @default(0.7) /// Generation temperature (0.0 - 2.0)
  maxTokens   Int      @default(16384) /// Maximum output tokens (CI-1: 4096→16384 — giảm cắt ngang giữa chừng khi sinh file code lớn)
  team        String?  /// Team: "code" | "research" | null (không bắt buộc)
  position    String?  /// Vị trí trong team: TL | G1 | G2 | G3 | G4 (code) | TL | G1 | G2 | G3 (research)
  avatar      String?  /// Emoji hoặc icon name cho avatar
  /// Tool whitelist (JSON array string) — user request 2026-09-08 (Omega Agent
  /// Factory): agent do Omega tạo qua create_agent mang toolset riêng. null =
  /// resolve theo logic cũ (standalone def → [], tức mọi tool đều được phép).
  /// Chuẩn hoá tại chat route: JSON.parse(profile.tools) ?? fallback.
  tools       String?  /// JSON: ["file_read", "shell", ...]
  isSystem    Boolean  @default(false) /// System agent — seeded on startup, cannot be deleted. Customizable but persistent.
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  /// Related sessions — one agent can have many chat sessions
  sessions    AgentSession[]

  @@index([team])
  @@index([provider])
  @@index([enabled])
  @@index([isSystem])
}

/// Agent chat sessions — tracks conversation sessions with OpenClaw agents
model AgentSession {
  id              String   @id @default(cuid())
  agentId         String   @default("default")
  sessionId       String   @unique
  model           String?
  provider        String?
  title           String?
  messageCount    Int      @default(0)
  agentProfileId  String?  /// FK → AgentProfile.id (null = default agent)
  teamMode        String?  /// "single" | "multi" — null = legacy session
  teamName        String?  /// "code" | "research" — null = single mode or legacy
  /// OPUS REVIEW MODE (user request 2026-09-30 — Opus CTO agent):
  /// "manual" = sau khi agent/team chạy xong, nút "Opus review" hiện dưới hàng
  /// like/dislike — user bấm mới review. "auto" = Opus TỰ review + TỰ hành động
  /// thay user sau mỗi run (chỉ dừng khi predicate 4 điều kiện thỏa — xem
  /// OpusReview + src/lib/opus/). null = "manual" (mặc định an toàn).
  opusReviewMode  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  agentProfile    AgentProfile? @relation(fields: [agentProfileId], references: [id], onDelete: SetNull)
  tasks           SmolabTask[]

  @@index([agentId])
  @@index([agentProfileId])
  @@index([teamName])
  @@index([createdAt])
}

/// Learning log — records all agent learning events (feedback, insights, corrections)
model LearningLog {
  id        String   @id @default(cuid())
  sessionId String?
  agentId   String   @default("default")
  eventType String   /// feedback | insight | correction | preference | pattern
  content   String   /// JSON string with event details
  metadata  String?  /// Optional JSON metadata
  createdAt DateTime @default(now())

  @@index([agentId])
  @@index([eventType])
  @@index([createdAt])
}

/// Agent insights — auto-extracted or manually taught knowledge
model AgentInsight {
  id         String   @id @default(cuid())
  agentId    String   @default("default")
  content    String
  source     String   /// auto | manual | feedback | correction
  type       String   /// factual | procedural | preference | pattern
  confidence Float    @default(0.5)
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@index([type])
  @@index([createdAt])
}

/// Agent corrections — tracks when agent was wrong and corrected
model AgentCorrection {
  id            String   @id @default(cuid())
  agentId       String   @default("default")
  wrongAnswer   String
  correctAnswer String
  reason        String?
  applied       Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([agentId])
  @@index([applied])
}

/// Agent preferences — learned user preferences and behavioral patterns
model AgentPreference {
  id              String   @id @default(cuid())
  agentId         String   @default("default")
  preferenceKey   String
  preferenceValue String
  source          String   /// auto | manual | feedback
  createdAt       DateTime @default(now())

  @@unique([agentId, preferenceKey])
}

/// Agent skills — installed and custom SKILL.md instruction packs
model AgentSkill {
  id          String   @id @default(cuid())
  agentId     String   @default("default")
  slug        String
  name        String
  content     String   /// SKILL.md content
  source      String   @default("bundled") /// clawhub | custom | bundled
  enabled     Boolean  @default(true)
  version     String   @default("1.0.0")
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([agentId, slug])
}

/// Custom tools — tools do agents/user tự viết (handler JS chạy trong sandbox).
/// Agent gọi tool create_custom_tool → lưu đây → dùng NGAY qua registry in-memory.
/// Mỗi custom tool tự tạo 1 AgentSkill companion (source 'agent-tool') để hiện
/// trong ô "SKILL.md Guides" của module Skills (user request 2026-08-30).
model CustomTool {
  id          String   @id @default(cuid())
  name        String   @unique /// tool name agents gọi: tool_call: <name>({...})
  description String
  parameters  String   /// JSON schema (object type) — mô tả args cho LLM
  handlerCode String   /// JS: function handler(args, sandbox) { ... return result }
  version     String   @default("1.0.0")
  source      String   @default("agent") /// agent | user | clawhub
  category    String   @default("custom")
  enabled     Boolean  @default(true)
  isPublic    Boolean  @default(false)
  skillSlug   String?  /// slug AgentSkill companion (nếu có)
  callCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Tool permissions — controls which tools each agent can use
model ToolPermission {
  id         String @id @default(cuid())
  agentId    String @default("default")
  toolName   String
  permission String /// allow | deny | ask

  @@unique([agentId, toolName])
}

/// Knowledge access policy — controls agent DB access (read/write/delete)
model KnowledgeAccessPolicy {
  id                 String  @id @default(cuid())
  agentId            String  @default("default")
  allowRead          Boolean @default(true)
  allowWrite         Boolean @default(true)
  allowDelete        Boolean @default(false)
  allowedCollections String  @default("theopus_documents,theopus_chunks")
  allowedLabels      String  @default("*")

  @@unique([agentId])
}

/// Cron jobs — scheduled agent tasks
model CronJob {
  id         String    @id @default(cuid())
  agentId    String    @default("default")
  expression String
  taskPrompt String
  enabled    Boolean   @default(true)
  lastRunAt  DateTime?
  nextRunAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // Phase 4.6 — Z.ai Code parity cron tool (spec v2.1 lines 263-281)
  // All fields have defaults so existing rows (from cron-tool v1) don't break.
  // kind: 'one_time' (epoch-ms expr) | 'cron' (cron expression) | 'fixed_rate' (interval)
  kind        String   @default("cron")
  /// epoch-ms (one_time) | cron expression | interval string (fixed_rate)
  expr        String   @default("")
  /// IANA timezone, e.g. 'Etc/GMT-7'
  tz          String?
  /// Agent task description (mirror of taskPrompt for the new tool surface)
  task        String   @default("")
  /// Resume an existing session instead of starting fresh
  sessionId   String?
  retryCount  Int      @default(0)
  maxRetries  Int      @default(3)
  lastError   String?
  /// Dedup hash (sha256 of {schedule, task, sessionId}) — refuse duplicate schedules
  jobHash     String?
  /// 'active' | 'paused' | 'completed' | 'failed'
  status      String   @default("active")

  // ===== CRON BUILDER (user request 2026-09-14) =====
  // Lịch có cấu trúc dựng từ UI Smolab > Automation (nút Ngày/Tuần/Tháng +
  // chọn giờ + nút Thêm + nút Lặp) và từ tool manage_automation của agents.
  // JSON: {mode:'day'|'week'|'month', times:['09:30','14:00'],
  //        daysOfWeek:[1,3], daysOfMonth:[1,15], repeat:true}
  // - mode='day': chạy (lặp) vào các giờ trong `times` mỗi ngày; repeat=false → chạy 1 lần.
  // - mode='week': các ngày trong `daysOfWeek` (0=CN..6=T7) × `times`.
  // - mode='month': các ngày trong `daysOfMonth` (1-31) × `times`.
  // null = cron expression thô (legacy) — vẫn hoạt động như trước.
  /// Structured schedule config — null khi job dùng cron expression thô
  scheduleJson String?
  /// Người thực thi: '' (Automation Agent mặc định) | tên agent ('RAMPAGE') | 'team:code' (TL của team điều phối triển khai toàn bộ tác vụ)
  executor    String   @default("")

  @@index([agentId])
  @@index([enabled])
  @@index([status])
  @@index([nextRunAt])
  @@index([jobHash])
}

/// Phase 4.4 — PendingEdits human review integration.
/// Spec v2.1 lines 252 (4.4): "Wire PendingEdits into workflow".
/// Replaces an in-memory concept with a persistent DB record so user can approve/
/// reject via /api/openclaw/pending-edits. Field names follow the spec exactly;
/// legacy field names (oldContent/newContent/agentName/resolvedAt) are kept as
/// backward-compat aliases so the existing workspace-manager.ts methods that the
/// /api/workspace + /api/code-team/checkpoints routes depend on continue to work.
/// Spec: docs/FULLSTACK_CAPABILITY_PLAN_V2.md Phase 4.4
model PendingEdit {
  id          String   @id @default(cuid())
  sessionId   String
  filePath    String
  /// 'edit' | 'delete' | 'multi_edit' | 'create' — Phase 4.4 spec
  operation   String   @default("edit")
  /// Original content snapshot (for edit/delete) — spec name
  before      String?
  /// New content (for edit/create) — spec name
  after       String?
  /// Unified diff string for UI display
  diff        String?
  /// 'low' | 'medium' | 'high' — Phase 4.4 spec
  riskLevel   String   @default("low")
  /// 'pending' | 'approved' | 'rejected' | 'applied' — spec lifecycle
  status      String   @default("pending")
  /// Who approved/rejected (user ID or agent name acting as reviewer)
  reviewerId  String?
  reviewedAt  DateTime?
  appliedAt   DateTime?
  createdAt   DateTime @default(now())

  // ===== Legacy backward-compat aliases (workspace-manager.ts v1 schema) =====
  // These mirror `before`/`after`/reviewer fields so the existing methods on
  // /api/workspace + /api/code-team/checkpoints continue to compile + work.
  oldContent  String   @default("")
  newContent  String   @default("")
  agentName   String   @default("")
  resolvedAt  DateTime?

  @@index([sessionId])
  @@index([status])
  @@map("pending_edits")
}

/// Phase 4.1 — Neo4j differential checkpoint storage.
/// Spec v2.1 lines 252 (4.1): "Store diff in SQLite table Neo4jCheckpointDiff".
/// Stores only nodes/rels updated since the last checkpoint (differential strategy).
/// Full export only on explicit checkpoint_create({ full: true }) or daily cron.
/// Spec: docs/FULLSTACK_CAPABILITY_PLAN_V2.md Phase 4.1
model Neo4jCheckpointDiff {
  id         String   @id @default(cuid())
  sessionId  String
  label      String   @default("")
  /// true if this is a full export, false if differential
  full       Boolean  @default(false)
  /// JSON-stringified array of node objects
  nodesJson  String
  /// JSON-stringified array of relationship objects
  relsJson   String
  nodeCount  Int      @default(0)
  relCount   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
  @@map("neo4j_checkpoint_diffs")
}

/// Workspace — folder tracked as the active scope for code agent operations.
/// Referenced by WorkspaceManager since Phase 1; re-added to schema in Phase 4
/// (4.4 PendingEdits integration) to fix the runtime "db.workspace is undefined"
/// error that surfaced once /api/workspace route started being exercised.
model Workspace {
  id        String   @id @default(cuid())
  name      String
  rootPath  String   @unique
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

/// FsCheckpoint — DB record shadowing the on-disk .code-team-checkpoints/
/// snapshots (filesystem layout managed by src/lib/workspace/fs-checkpoint.ts).
/// Referenced by WorkspaceManager.createCheckpoint/listCheckpoints since Phase 1.
model FsCheckpoint {
  id          String   @id @default(cuid())
  sessionId   String
  workspaceId String
  commitHash  String
  label       String
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([workspaceId])
}

/// AgentModelOverride — per-agent provider/model override (used by WorkspaceManager).
model AgentModelOverride {
  agentName String   @unique
  provider  String
  model     String
  updatedAt DateTime @updatedAt
}

/// Webhooks — inbound/outbound webhook configurations
model Webhook {
  id        String   @id @default(cuid())
  agentId   String   @default("default")
  url       String
  events    String   /// JSON array of event types
  secret    String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
}

/// Standing orders — persistent agent instructions
model StandingOrder {
  id        String   @id @default(cuid())
  agentId   String   @default("default")
  order     String
  priority  Int      @default(0)
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([agentId])
}

/// Task Flow (user request 2026-09-13) — quy trình tự động hóa THIẾT KẾ ĐƯỢC
/// (chuỗi bước Trigger → Action → Condition → Result) do user tinh chỉnh qua
/// UI Smolab > Automation, hoặc do Omega tinh chỉnh qua tool manage_automation.
/// Scheduler poll (/api/openclaw/automation/scheduler) tự chạy flow có trigger
/// cron đến hạn (nextRunAt); chạy tay qua POST /api/task-flows/[id]?action=run.
model TaskFlow {
  id          String    @id @default(cuid())
  name        String
  description String    @default("")
  /// JSON array các bước: [{id, type: trigger|action|condition|result, title, config}] — xem src/lib/task-flows.ts
  stepsJson   String
  enabled     Boolean   @default(true)
  /// user | omega | agent:<name> | self-direction
  createdBy   String    @default("user")
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([enabled])
  @@index([nextRunAt])
}

/// Task execution history — tracks all automation task runs
model TaskExecution {
  id           String    @id @default(cuid())
  jobId        String?
  type         String    /// cron | webhook | heartbeat | manual
  status       String    /// pending | running | completed | failed
  result       String?
  errorMessage String?
  startedAt    DateTime  @default(now())
  completedAt  DateTime?

  @@index([type])
  @@index([status])
  @@index([startedAt])
}

/// Channel configurations — messaging platform connections
model ChannelConfig {
  id          String    @id @default(cuid())
  channelType String    @unique /// telegram | discord | slack | webchat | ...
  config      String    /// JSON config (tokens, URLs, etc.)
  enabled     Boolean   @default(false)
  connectedAt DateTime?
}

/// Local resolved entities — deduplicated canonical entities, batch synced to Neo4j
model LocalResolvedEntity {
  id              String   @id @default(uuid()) /// Pre-generated UUID
  documentId      String?  /// Reference to the document UUID (Qdrant point ID)
  canonicalName   String   @unique /// Unique canonical name
  entityType      String   /// Entity type
  description     String?  /// Merged description
  properties      String?  /// JSON string of merged properties
  avgConfidence   Float    @default(0.5)
  occurrenceCount Int      @default(1)
  domains         String?  /// JSON array of domains
  synced          Boolean  @default(false) /// Whether synced to Neo4j
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([documentId])
  @@index([synced])
}

// ============================================
// OPENCODE CODING AGENT SYSTEM
// AI Coding Agent — file ops, bash, LSP, MCP bridge
// Port: 18790 (mini-service)
// ============================================

/// OpenCode sessions — tracks coding agent sessions (synced from OpenCode server)
model OpenCodeSession {
  id           String   @id @default(cuid())
  sessionId    String   @unique
  model        String?
  provider     String?
  prompt       String?
  status       String   @default("active") /// active | paused | completed | failed
  filesTouched String   @default("[]") /// JSON array of file paths modified
  toolsUsed    String   @default("[]") /// JSON array of tool names used
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

/// MCP Bridge configuration — controls tool sharing between OpenClaw and OpenCode
model MCPBridgeConfig {
  id        String   @id @default(cuid())
  direction String   /// outbound (OpenClaw→OpenCode) | inbound (OpenCode→OpenClaw)
  toolName  String
  enabled   Boolean  @default(true)
  config    String   @default("{}") /// JSON config for the tool mapping
  updatedAt DateTime @updatedAt

  @@unique([direction, toolName])
  @@index([direction])
}

// ============================================
// AUTO-LEARN SYSTEM (Phase 4)
// Agent tự bổ sung kiến thức vào DB khi confidence thấp
// ============================================

/// Auto-learn records — tracks when agents self-learn and add knowledge to DB
model AutoLearnRecord {
  id                 String   @id @default(cuid())
  agentId            String   /// AgentProfile.id
  agentName          String   /// Agent name (denormalized for quick display)
  query              String   /// Original user query
  answerPreview      String   /// First 500 chars of agent answer
  confidence         Float    /// Confidence score of the answer
  provider           String   /// Provider used (e.g. "mistral")
  model              String   /// Model used (e.g. "mistral-large-2512")
  entitiesCount      Int      @default(0) /// Number of entities extracted
  relationshipsCount Int      @default(0) /// Number of relationships extracted
  chunkSaved         Boolean  @default(false) /// Whether chunk was saved to Qdrant
  neo4jSynced        Boolean  @default(false) /// Whether Neo4j sync completed
  qdrantPointId      String?  /// Qdrant point ID of the stored vector
  documentId         String?  /// Virtual document ID for auto-learned knowledge
  status             String   @default("pending") /// pending | completed | failed
  errorMessage       String?  /// Error message if auto-learn failed
  createdAt          DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
  @@index([confidence])
  @@index([status])
}

// ============================================
// EMBEDDING CACHE (Phase 6)
// SQLite-backed L2 cache — survives server restarts
// L1 = in-memory Map (1h TTL, fast), L2 = SQLite (7d TTL, persistent)
// ============================================

/// Embedding cache — stores previously computed embeddings to avoid redundant API calls
/// Survives server restarts (unlike in-memory cache)
/// IMPORTANT: Same text gets DIFFERENT embeddings for "query" vs "passage" (NVIDIA input_type)
/// So the unique key is (hash, inputType) — NOT just hash
model EmbeddingCache {
  id        String   @id @default(cuid())
  hash     String   /// SHA-256 hash of the input text
  inputType String  @default("passage") /// "query" | "passage" — different embeddings for same text
  model    String   /// Model used to generate the embedding (e.g. "nvidia/llama-nemotron-embed-1b-v2")
  vector   String   /// JSON array of the embedding vector (1536 floats)
  hitCount Int      @default(1) /// Number of cache hits (for LRU eviction)
  createdAt DateTime @default(now())
  lastHitAt DateTime @default(now()) /// Last time this cache entry was used
  expiresAt DateTime /// When this cache entry expires

  @@unique([hash, inputType]) /// Composite key — same text has separate query & passage embeddings
  @@index([expiresAt])
  @@index([lastHitAt])
}

// ============================================
// CODE TEAM WORKFLOW SYSTEM
// Multi-agent code team — worklog, sessions, tool calls
// ============================================

/// Code Team worklog entries — tracks each agent's output in a workflow session
model CodeTeamWorklog {
  id          String   @id @default(cuid())
  sessionId   String   /// Session ID (maps to AgentSession.sessionId)
  agentName   String   /// MEGATRON | SHOCWAVE | RAMPAGE | SENTINEL | CATALYST
  position    String   /// TL | G1 | G2-A | G2-B | G3
  step        String   /// analyze | design | code | review | optimize | verify | routing
  summary     String   /// Tóm tắt những gì agent đã làm
  content     String   /// JSON: full WorklogEntry (issues, codeLocationMap, suggestions, etc.)
  toolCalls   String   @default("[]") /// JSON: array of tool calls made during this step
  duration    Int      @default(0) /// Duration in milliseconds
  createdAt   DateTime @default(now())

  @@index([sessionId])
  @@index([agentName])
  @@index([sessionId, position])
  @@index([createdAt])
}

/// Code Team workflow sessions — tracks overall workflow state
model CodeTeamSession {
  id              String   @id @default(cuid())
  sessionId       String   @unique /// Maps to AgentSession.sessionId
  routingMode     String   /// A | B | C
  tier            Int      /// 1 | 2 | 3
  score           Int      /// Complexity score 3-9
  currentStep     String   @default("pending") /// pending | running | checkpoint | completed | failed
  currentAgent    String?  /// Agent đang chạy
  completedAgents String   @default("[]") /// JSON: array of completed agent names
  partsDefinition String   @default("[]") /// JSON: array of PartDefinition from TL
  opencodeSessionId String? /// OpenCode session ID (nếu có)
  totalDuration   Int      @default(0) /// Total duration in ms
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sessionId])
  @@index([currentStep])
  @@index([createdAt])
}

// ============================================
// AGENT MEMORY & LEARNING SYSTEM
// Episodic Memory (Qdrant) + Semantic Memory (Neo4j) + User Profile
// ============================================

/// Chat messages — persisted per session, used for Memory extraction
model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String   /// AgentSession.sessionId
  role      String   /// user | assistant | system | tool_call | error
  content   String   /// Message text content
  model     String?  /// LLM model used (for assistant messages)
  provider  String?  /// LLM provider used
  metadata  String?  /// JSON: sources, confidence, toolCalls, etc.
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([role])
  @@index([createdAt])
}

// ============================================
// SMOLAB BACKGROUND TASK SYSTEM
// Chat session isolation + background task continuation
// When user switches sessions, tasks in previous sessions continue running.
// Max 3 concurrent tasks via SmolabTaskWorker singleton.
// ============================================

/// Smolab background tasks — tracks long-running agent/team work that continues
/// even when user switches to another session. Each task is tied to one session
/// and one agent (or team lead agent).
model SmolabTask {
  id              String   @id @default(cuid())
  type            String   /// "agent_chat" | "team_workflow" | "agent_react" | "memory_extraction"
  status          String   @default("pending") /// "pending" | "running" | "completed" | "failed" | "cancelled"
  progress        Int      @default(0) /// 0-100 percentage

  // Liên kết Session + Agent
  sessionId       String   /// AgentSession.sessionId — phiên chat gốc
  agentProfileId  String?  /// AgentProfile.id — agent đang xử lý (null nếu team mode)
  teamName        String?  /// "code" | "research" — team đang xử lý (nếu team mode)

  // Task input/output
  inputSummary    String?  /// Tóm tắt yêu cầu (first 200 chars của user message)
  result          String?  /// Kết quả khi hoàn thành (JSON string)
  error           String?  /// Lỗi nếu thất bại

  // Thời gian
  createdAt       DateTime @default(now())
  startedAt       DateTime?
  completedAt     DateTime?
  updatedAt       DateTime @updatedAt

  /// Phase 3 SMOLAB Prop 9 — Durable queue crash-recovery counters.
  /// `attempts` is incremented on each crash recovery (process restart while
  /// task is still pending/running). When `attempts >= maxAttempts` the
  /// recoverPending() pass marks the task as 'failed' instead of re-enqueuing
  /// (don't infinite-retry orphaned tasks).
  attempts        Int      @default(0) /// # of crash-recovery attempts (0 = never recovered)
  maxAttempts     Int      @default(3) /// ceiling — after this many recovery attempts, mark failed

  // Relations — Cascade: khi session bị xóa, tất cả tasks của session đó cũng bị xóa
  session         AgentSession  @relation(fields: [sessionId], references: [sessionId], onDelete: Cascade, onUpdate: Cascade)

  @@index([sessionId])
  @@index([agentProfileId, status])
  @@index([teamName, status])
  @@index([status])
  @@index([createdAt])
}

/// Agent episodic memories — extracted from conversations, stored as vectors in Qdrant
/// Each memory is a discrete piece of knowledge the agent learned from interaction
///
/// Memory Tier Architecture (Phase 4):
///   - HOT  → WorkingMemory table (current session, in-RAM fallback)
///   - WARM → AgentMemory table (this table — verified important, isActive=true)
///   - COLD → MemoryArchive table (compressed summary, isActive=false here)
model AgentMemory {
  id             String   @id @default(cuid())
  agentId        String   /// AgentProfile.id
  agentName      String   /// Agent name (denormalized)
  sessionId      String?  /// Source session
  category       String   /// insight | fact | preference | correction | procedure | user_info
  content        String   /// The actual memory content (text)
  context        String?  /// Context: what triggered this memory (query, situation, etc.)
  importance     Float    @default(0.5) /// 0.0-1.0 — how important this memory is
  accessCount    Int      @default(0) /// How many times this memory was recalled
  lastAccessedAt DateTime? /// Last time this memory was used in a response
  qdrantPointId  String?  /// Qdrant point ID for vector search
  embeddingModel String?  /// Embedding model used (e.g. nvidia/llama-nemotron-embed-1b-v2)
  source         String   @default("auto") /// auto | manual | feedback | correction | auto-learn
  tags           String?  /// JSON array of tags for categorization
  /// Memory domain — separates user data from work data (Phase 4)
  /// "user" = personal info (name, language, preferences) — decays slowly
  /// "work" = project/code/technical — decays by project cycle
  /// "meta" = patterns about how user interacts — never decays
  domain         String   @default("work") /// user | work | meta
  isActive       Boolean  @default(true) /// Soft delete — inactive memories are not recalled
  /// Tier: which memory tier this belongs to (Phase 4)
  /// "warm"  = active long-term (default)
  /// "cold"  = archived (also has MemoryArchive record)
  tier           String   @default("warm") /// warm | cold
  expiresAt      DateTime? /// Optional expiration for time-sensitive memories
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([agentId])
  @@index([category])
  @@index([importance])
  @@index([accessCount])
  @@index([isActive])
  @@index([createdAt])
  @@index([lastAccessedAt])
  @@index([domain])
  @@index([tier])
}

/// Working Memory (HOT tier) — current session messages + recent recalls.
/// TTL = session end + 1h grace. Promoted to AgentMemory (WARM) on session end.
/// Survives server restarts (unlike pure in-RAM cache).
model WorkingMemory {
  id          String   @id @default(cuid())
  agentId     String   /// AgentProfile.id
  sessionId   String   /// Current chat session
  content     String   /// Raw chat message or recalled memory text
  /// Role in conversation: user message, assistant response, system note, or recall
  role        String   /// user | assistant | system | recall
  importance  Float    @default(0.8) /// HOT defaults high — promoted if still relevant
  /// When this working memory expires (session end + 1h grace)
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  @@index([agentId, sessionId])
  @@index([expiresAt])
  @@index([createdAt])
}

/// Memory Archive (COLD tier) — compressed long-term storage.
/// Created when WARM memories decay below threshold (importance < 0.1, isActive=false).
/// Multiple WARM memories → 1 COLD summary (via LLM summarization, Phase 5).
/// Hard-deleted after 90 days (configurable).
model MemoryArchive {
  id             String   @id @default(cuid())
  agentId        String   /// AgentProfile.id
  /// JSON array of source AgentMemory IDs that were merged into this archive
  originalIds    String   /// JSON: ["memId1", "memId2", ...]
  /// LLM-compressed summary of the source memories (Phase 5)
  summaryContent String   /// Compressed text (typically 100-300 chars from 5-10 memories)
  /// Domain tag carried over from source memories
  domain         String   @default("work") /// user | work | meta
  /// Lowered importance after compression (default 0.3, can be boosted on recall)
  importance     Float    @default(0.3)
  /// How many source memories were merged into this summary
  sourceCount    Int      @default(1)
  /// Embedding of the summary (for similarity search in COLD tier)
  qdrantPointId  String?  /// Qdrant point ID for vector search on archive
  embeddingModel String?  /// Embedding model used
  /// Auto-delete after 90 days (configurable via expiresAt)
  expiresAt      DateTime? /// 90 days after createdAt → hard delete
  createdAt      DateTime @default(now())

  @@index([agentId])
  @@index([expiresAt])
  @@index([domain])
  @@index([importance])
}

/// User profile — accumulated knowledge about the user across all conversations
model UserProfile {
  id            String   @id @default(cuid())
  userId        String   @default("default") /// Multi-user support for future
  key           String   /// Profile key: name, language, role, expertise, preference_xxx, etc.
  value         String   /// Profile value
  source        String   @default("auto") /// auto | manual | agent_observation
  confidence    Float    @default(0.5) /// How confident we are about this profile fact
  accessCount   Int      @default(0) /// How many times this was used
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([userId, key])
  @@index([userId])
  @@index([key])
  @@index([isActive])
}

/// Memory access log — tracks which memories are recalled, for decay/relevance optimization
model MemoryAccessLog {
  id        String   @id @default(cuid())
  memoryId  String   /// AgentMemory.id
  agentId   String   /// Which agent accessed this memory
  sessionId String?  /// In which session
  query     String?  /// What query triggered the recall
  relevance Float    @default(0.5) /// How relevant the memory was (0-1)
  createdAt DateTime @default(now())

  @@index([memoryId])
  @@index([agentId])
  @@index([createdAt])
}

/// Phase 1a.2 — Todo list items (DB-backed replacement for globalThis.__devTasks).
/// Used by `todo_write` / `todo_read` tools (see dev-tools.ts).
/// Both Code Team agents (TL|G1|G2-A|G2-B|G3 in agentRole) AND independent agents
/// (agentRole=null) share this table — sessionId scopes each conversation.
/// Spec: docs/FULLSTACK_CAPABILITY_PLAN_V2.md Part 4 Phase 1a.2
model Todo {
  id             String   @id @default(cuid())
  /// Session scope — every chat conversation gets its own todo list.
  /// Default "default" for legacy callers without a sessionId.
  sessionId      String   @default("default")
  /// Agent position (TL|G1|G2-A|G2-B|G3) for Code Team, or null for independent agents
  /// invoked via /api/openclaw/chat (which calls executeTool directly).
  agentRole      String?
  /// The todo item content (human-readable text the agent wants to track)
  content        String
  /// allowed: pending | in_progress | blocked | completed | failed
  status         String   @default("pending")
  /// allowed: low | medium | high
  priority       String   @default("medium")
  /// Optional parent todo ID for nested task breakdown (G1 decompose_task style)
  parentId       String?
  /// Stable ordering for display (auto-assigned if not provided)
  position       Int      @default(0)
  /// Optional client-supplied idempotency key — when set, repeat calls with
  /// same key return the existing todo instead of creating a duplicate.
  idempotencyKey String?
  /// CI-2 (Task 11-a) — Run scope: todo thuộc về ĐÚNG 1 agent run (runId do
  /// startAgentRun sinh ra; goal-loop inject vào todo_write). null = todo
  /// legacy (trước CI-2) hoặc caller không có run — vẫn hiển thị theo session
  /// như cũ và KHÔNG bị archive khi run mới bắt đầu.
  runId          String?
  /// CI-2 (Task 11-a) — Thời điểm todo bị lưu trữ: (a) status='archived' khi
  /// run mới bắt đầu (archive todo mở của các run trước), hoặc (b) pending
  /// được giữ nguyên lúc run kết thúc CHƯA đạt mục tiêu (trung thực — chưa làm
  /// gì thì không thành failed) nhưng đánh dấu archivedAt để ẩn khỏi run sau.
  archivedAt     DateTime?
  /// FIX ghost system (user report 2026-09-14 #4): decompose_task/create_task
  /// trước đây chỉ ghi globalThis.__devTasks (mất khi restart). Giờ DAG subtask
  /// map bền vững vào DB Todo: idempotencyKey = "task:T00N" (taskId ổn định),
  /// taskMetaJson = {"taskId","title","spec","assignee","deps":["T00M"],"notes"}.
  /// get_plan đọc lại từ DB (durable qua restart) — pipeline/agent sau truy vấn
  /// được kế hoạch phân rã của run trước.
  taskMetaJson    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sessionId])
  @@index([sessionId, agentRole])
  @@index([sessionId, runId])
  @@index([parentId])
  @@index([idempotencyKey])
}

/// P8 (2026-11 — user directive: agents phải có "cơ chế tạo dữ liệu công việc
/// vào DB để theo dõi rồi tự dọn dẹp" thay vì ghi file rải rác). Bảng lưu trữ
/// dữ liệu công việc CÓ VÒNG ĐỜI của agents — CRUD qua tool work_data
/// (src/lib/code-team/dev-tools.ts). Ownership: CHỈ agent tạo row (agentName)
/// mới sửa/xoá được; đọc get/list giới hạn trong sessionId. Bộ dọn tự động
/// (instrumentation-node.ts sweepAgentWorkData) xoá bản ghi completed/obsolete
/// quá 7 ngày không đụng tới hoặc đã quá expiresAt.
model AgentWorkData {
  id          String   @id @default(cuid())
  /// Session scope — bản ghi thuộc về 1 phiên chat; get/list chỉ thấy trong phiên
  sessionId   String
  /// runId của run tạo bản ghi (goal-loop / delegation sub-run) — null khi caller không có run
  runId       String?
  /// Agent tạo bản ghi (ownership — chỉ agent này được put-with-id/set_status/delete)
  agentName   String
  /// Phân loại dữ liệu do agent tự khai (vd evidence | plan | note | scratch)
  kind        String
  /// Khóa tra cứu tùy chọn (get theo key trong session; list tìm contains)
  key         String?
  /// Nội dung dữ liệu công việc (cap 131072 ký tự tại tool layer)
  content     String
  /// allowed: active | completed | obsolete (set_status — cho phép hồi sinh về active)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  /// Thời điểm bản ghi đạt trạng thái completed (set_status → now; hồi sinh → null)
  completedAt DateTime?
  /// Hạn dọn dẹp tùy chọn — bộ dọn tự động xoá khi quá hạn bất kể status
  expiresAt   DateTime?

  @@index([sessionId, status])
  @@index([status, expiresAt])
  @@index([runId])
}

/// Spec: docs/FULLSTACK_CAPABILITY_PLAN_V2.md Part 11.1 (Phase 3 — observability)
/// Logs every executeTool() call: success/exitCode/durationMs/errorTag for
/// per-tool error budget tracking + P50/P95/P99 latency monitoring.
model ToolMetric {
  id          String   @id @default(cuid())
  /// Tool name (shell, file_edit, run_tests, git_commit, lsp_diagnostics, ...)
  toolName    String
  /// Session ID for correlation with chat sessions
  sessionId   String
  /// Agent role: TL | SHOCWAVE | RAMPAGE | SENTINEL | CATALYST | INDEPENDENT
  agentRole   String
  /// true if tool succeeded, false otherwise
  success     Boolean
  /// Exit code (for shell/test runners); null for non-exit-code tools
  exitCode    Int?
  /// Wall-clock duration in ms
  durationMs  Int
  /// Categorized error tag (e.g. 'timeout', 'parse_error', 'permission')
  errorTag    String?
  timestamp   DateTime @default(now())

  @@index([toolName])
  @@index([sessionId])
  @@index([timestamp])
  @@index([success])
}

/// Task 20-b (self-monitoring) — persist run lifecycle của mỗi agent run
/// (chat goal-loop / team workflow). Trước đây goal-loop metadata (cycles,
/// stopReason, evaluatorConfidence, tokensUsed...) chỉ sống trong
/// ChatMessage.metadata JSON + agent-run-tracker in-memory (mất khi restart).
/// AgentRunRecord ghi 1 row/run khi run KẾT THÚC (endAgentRun / user cancel).
/// v1 (20-b): tokensUsed/evaluatorConfidence/cycles = null — task 20-c sẽ wire
/// goal-loop metadata thật; stopReason v1 là heuristic map từ tracker status
/// (complete|error|cancelled), các lý do budget (max_cycles|time_budget|
/// token_budget|no_progress) chờ 20-c.
model AgentRunRecord {
  id            String   @id @default(cuid())
  sessionId     String
  /// ChatMessage id của user message gốc (20-c wire — v1 null)
  messageId     String?
  /// FIX (user report 2026-09-14 #5 — 20-c wire): runId của run (run_xxx /
  /// sub_xxx delegation). Trước đây thiếu cột → delegation rows KHÔNG truy
  /// vấn được theo run. Giờ: query theo runId (đúng row) hoặc parentRunId
  /// (mọi delegation rows của 1 run cha).
  runId         String?
  /// runId của run CHA (delegation: goal-loop / pipeline step cha) — null với
  /// run top-level. Kèm index để truy "mọi sub-agent đã chạy cho run X".
  parentRunId   String?
  agentId       String?
  agentName     String?
  /// running | completed | failed | cancelled
  status        String?
  /// complete | max_cycles | time_budget | token_budget | no_progress | cancelled | error
  stopReason    String?
  cycles        Int?
  tokensUsed    Int?
  toolCalls     Int?
  toolFailures  Int?
  durationMs    Int?
  evaluatorConfidence Float?
  complete      Boolean?
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([createdAt])
  @@index([stopReason])
  @@index([runId])
  @@index([parentRunId])
}

/// Task 20-c (self-evaluation) — persist verdict của TRỌNG TÀI ĐỘC LẬP (EVALUATE
/// step trong agent-goal-loop) mỗi chu kỳ. Mỗi verdict là 1 DỰ ĐOÁN của trọng
/// tài: P(mục tiêu hoàn thành) = confidence. Khi run kết thúc thật sự,
/// resolveArbiterVerdicts() ghi outcome (confirmed|refuted) bằng cách đối chiếu
/// verdict.complete với run kết quả cuối → dữ liệu để tính Brier/ECE calibration
/// của trọng tài (GET /api/eval/calibration). Trước đây verdict chỉ sống trong
/// ChatMessage.metadata.goalLoop JSON — không đo được sai số dự đoán.
model ArbiterVerdict {
  id          String    @id @default(cuid())
  sessionId   String
  /// ChatMessage id của assistant reply (link sau khi message persist — nullable)
  messageId   String?
  agentName   String?
  /// Chu kỳ EVALUATE thứ mấy của run (1-based)
  cycle       Int
  /// Verdict EFFECTIVE sau verify-guard (harness hạ cấp complete→false khi
  /// có modify-tool chạy sau verify-tool cuối — đây là verdict hệ thống THẬT SỰ tin)
  complete    Boolean
  /// P(complete) theo trọng tài — 0.0-1.0
  confidence  Float
  verified    Boolean
  /// JSON array các mục còn thiếu (theo trọng tài)
  missing     String?
  rootCause   String?
  /// true khi verify-guard hạ cấp verdict.complete true→false
  forcedDowngrade Boolean @default(false)
  /// stopReason của run khi verdict được resolve (ghi kèm lúc resolve)
  runStopReason  String?
  /// kết quả cuối của run khi verdict được resolve
  runComplete    Boolean?
  /// confirmed | refuted | null (chưa resolve — run còn chạy)
  outcome     String?
  outcomeAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([sessionId, createdAt])
  @@index([outcome])
  @@index([confidence])
}

/// Phase 5.6 — Session Resume (spec Appendix C, docs/FULLSTACK_CAPABILITY_PLAN_V2.md
/// lines 723-779).
///
/// Persistent workflow state for context-overflow recovery + concurrent lock.
/// When an agent detects context overflow, it pauses the session, serializes its
/// state (currentStep, todoIds, last 5 tool receipts) into `state` (JSON TEXT),
/// and a new agent session can later POST /api/workflow/resume?sessionId=X to
/// re-inject the original task + todo list + last 5 tool receipts + current step.
///
/// Concurrent lock semantics (Appendix C.3):
///   - status='active' acts as the "lock held" marker.
///   - If 2 agents try to resume the same session → second gets 409 Conflict.
///   - Lock released on completion, failure, or 30-min timeout
///     (resumeWorkflowSession treats active+updatedAt<now-30min as expired lock).
///
/// Cleanup (Appendix C.5):
///   - >30 days with status='completed' → status='archived' (no real cold storage)
///   - >7 days with status='paused'    → console.warn (alert user)
///   - Max 100 active sessions per user → log warning (no FIFO eviction in sandbox)
model WorkflowSession {
  id              String   @id @default(cuid())
  /// TL | SHOCWAVE | RAMPAGE | SENTINEL | CATALYST (which agent owned the session)
  agentRole       String
  /// Original user request (so the resuming agent can re-read the task)
  taskDescription String
  /// JSON-serialized WorkflowState: { currentStep, todoIds, lastToolReceipts, ... }
  /// SQLite has no JSONB — TEXT column stores the JSON string (Appendix C.1 line 741).
  state           String
  /// active | paused | completed | failed | archived
  status          String   @default("active")
  /// Incremented each time the agent pauses due to context overflow (Appendix C.4)
  contextOverflowCount Int @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status, updatedAt])
}

/// Aggregated failure pattern detected from ExecutionMetrics history (Layer 9.2).

// ==================== Phase 6 SMOLAB Prop 2 — Layer 9 Prisma models ====================
// Spec: docs/SMOLAB_LEARNING_PROPOSALS.md Phase 1 Proposal 2.
// These 3 models are referenced by src/lib/learning/* but were missing → silent
// TypeError caught + swallowed → "phantom wired" Layer 9 (looks like it learns
// but persists NOTHING). Field shapes match src/lib/learning/types.ts + the
// actual db.*.create() callsites in metrics-collector.ts + strategy-adapter.ts.

/// Real-time metrics captured during workflow execution (Layer 9.1a).
/// Written by src/lib/learning/metrics-collector.ts:126 (flush()).
/// Read by src/lib/learning/historical-feedback.ts:17 (analyzeHistoricalFeedback).
model ExecutionMetrics {
  id                  String   @id @default(cuid())
  /// Workflow session ID for correlation
  sessionId           String
  /// Plan ID (from master-orchestrator orchestration plan)
  planId              String
  /// Routing mode: 'A' | 'B' | 'C' (used as proxy for task complexity)
  routingMode         String
  /// Tier: 1 | 2 | 3 (complexity tier)
  tier                Int
  /// Total steps in the workflow
  totalSteps          Int
  /// How many steps completed successfully
  completedSteps      Int
  /// How many steps failed
  failedSteps         Int
  /// Total tokens consumed (input + output, all LLM calls in workflow)
  totalTokensUsed     Int
  /// Token budget for the workflow (cap)
  totalTokensBudgeted Int
  /// Wall-clock time in ms
  totalTimeSpent      Int
  /// JSON map of error_type → count (e.g. {"type_error": 5, "runtime": 2})
  errorsByType        String
  /// 0.0-1.0 — completedSteps / totalSteps ratio
  stepSuccessRate     Float
  /// actual / budgeted (≤1.0 = good, >1.0 = over budget)
  tokenEfficiency     Float
  /// When this metrics record was created
  createdAt           DateTime @default(now())

  @@index([sessionId])
  @@index([routingMode])
  @@index([createdAt])
}

/// Failure pattern detected from ExecutionMetrics history (Layer 9.2).
/// Written by src/lib/learning/strategy-adapter.ts:234 (persistFailurePattern).
model FailurePattern {
  id              String   @id @default(cuid())
  /// Workflow session ID ('unknown' if not set by caller — see strategy-adapter.ts:230)
  sessionId       String
  /// Pattern type: 'repeated_error' | 'approach_exhausted' | 'resource_limit' | 'timeout'
  type            String
  /// Number of occurrences
  count           Int      @default(1)
  /// JSON array of strategies already tried (e.g. ["surgical", "refactoring"])
  strategiesTried String
  /// Suggested next strategy to try
  nextStrategy    String
  /// JSON context: { taskType, routingMode, stepType }
  context         String
  /// Whether this pattern has been applied/resolved
  resolved        Boolean  @default(false)

  @@index([sessionId])
  @@index([type])
  @@index([resolved])
}

/// Audit log of strategy adaptations applied (Layer 9.2).
/// Written by src/lib/learning/strategy-adapter.ts:268 (persistAdaptationLog).
model StrategyAdaptationLog {
  id              String   @id @default(cuid())
  /// Workflow session ID
  sessionId       String
  /// Failure pattern ID that triggered this adaptation (nullable for spontaneous adaptations)
  patternId       String?
  /// Strategy that was active before adaptation
  fromStrategy    String
  /// Strategy that was applied
  toStrategy      String
  /// Reason for the adaptation
  reason          String
  /// Confidence score (0.0-1.0) — how sure the adapter was about this switch
  confidence      Float
  /// null = pending, true = succeeded, false = failed
  successful      Boolean?
  /// ISO timestamp
  createdAt       DateTime @default(now())

  @@index([sessionId])
  @@index([patternId])
  @@index([createdAt])
}

// Phase 2 SMOLAB Proposal 6 — Atomic writeback saga tracking.
// Each multi-store writeback stamps a batchId; this model tracks step
// completion across Qdrant + Neo4j + SQLite. Failed batches get retried
// by /api/storage/reconcile-writebacks.
model PendingWriteback {
  id           String   @id @default(cuid())
  batchId      String   @unique
  agentId      String?
  sessionId    String?
  documentId   String
  payload      String   // JSON plan: {query, step2Content, step1Result, agentId, ...}
  steps        String   @default("[]") // JSON array: [{step, status, attempts, lastError}]
  status       String   @default("pending") // pending | completed | partial | failed
  failedStep   String?  // e.g. "qdrant" | "neo4j_entities" | "neo4j_relationships" | "memory" | "insight" | "log"
  attempts     Int      @default(0)
  maxAttempts  Int      @default(3)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
  @@index([agentId])
}

// Phase 3 SMOLAB Proposal 4.1 — Embedding model version tracking.
// Tracks every embedding model version used. Active version is the latest
// row where deprecatedAt IS NULL. When NVIDIA silently updates a model,
// a new row is inserted + old row's deprecatedAt set. Drift check in
// kb-access.ts queries Qdrant payloads and compares against active version.
model EmbeddingModelVersion {
  id            String    @id @default(cuid())
  modelName     String    // e.g. 'nvidia/llama-nemotron-embed-1b-v2'
  versionTag    String    // e.g. '2025-08-24' or commit hash
  config        String    @default("{}") // JSON: { dimensions: 2048, similarity: 'cosine' }
  activeSince   DateTime  @default(now())
  deprecatedAt  DateTime?

  @@unique([modelName, versionTag])
  @@index([modelName])
}

// Phase 4 SMOLAB Proposal 11' — Eval harness models.
// EvalCase: golden test question + expected answer. Mix of LLM-generated
// (constraint-diverse) + human-curated (from manual AgentInsights) + negative
// (out-of-domain — system must say "I don't know", NOT hallucinate).
model EvalCase {
  id               String   @id @default(cuid())
  question         String
  expectedAnswer   String
  expectedEntities String   @default("[]")  // JSON: [{name, type}]
  category         String   // programming | algorithm | ml | security | linux | negative | mixed
  difficulty       String   @default("medium")  // easy | medium | hard
  source           String   @default("llm_generated")  // llm_generated | human_curated | negative
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())

  @@index([category, active])
}

// EvalResult: per-case result within a run. faithfulnessScores stores all 3
// judge scores (variance estimate); faithfulnessMedian is the robust aggregate.
model EvalResult {
  id                        String   @id @default(cuid())
  runId                     String
  caseId                    String
  answer                    String
  retrievedChunks           Int      @default(0)
  expectedEntitiesInAnswer  Int      @default(0)
  expectedEntitiesRetrieved Int      @default(0)
  recallAt5                 Float    @default(0)
  faithfulnessMedian        Float    @default(0)
  faithfulnessScores        String   @default("[]")  // JSON [s1, s2, s3]
  extractionF1              Float    @default(0)
  hallucinationDetected     Boolean  @default(false)
  // ML evaluation fix (Task 4, 2026-08-25): coverage separates "did the system
  // attempt an answer" from faithfulness's "was the attempted answer correct".
  // Old faithfulness conflated both — refusals on in-domain questions scored
  // 0 faithfulness even though refusing is the RIGHT call for an empty KB.
  //   coverage = 1: answered (non-refusal) | 0: refused
  //   conditionalFaithfulness = faithfulnessMedian for ANSWERED cases only
  //   (negative cases: refusal IS the correct "answer" → coverage = 1 when refused)
  coverage                  Float    @default(0)
  answered                  Boolean  @default(false)
  rawConfidence             Float    @default(0)  // Prop 3.5 — Step-1 KB confidence (calibration training X)
  latencyMs                 Int      @default(0)
  createdAt                 DateTime @default(now())

  @@index([runId])
  @@index([caseId])
}

// EvalRun: one eval execution (may be background/async — completedAt null while running).
model EvalRun {
  id              String    @id @default(cuid())
  status          String    @default("running")  // running | completed | failed
  caseCount       Int       @default(0)
  processedCount  Int       @default(0)
  avgRecallAt5    Float     @default(0)
  avgFaithfulness Float     @default(0)
  // Task 4 (2026-08-25): avgCoverage = fraction of cases the system attempted
  // to answer (non-refusal). avgCondFaithfulness = faithfulness among ANSWERED
  // cases only — the honest "was the attempted answer right" number.
  avgCoverage     Float     @default(0)
  avgCondFaithfulness Float  @default(0)
  answeredCount   Int       @default(0)
  refusalCount    Int       @default(0)
  avgF1           Float     @default(0)
  avgLatencyMs    Int       @default(0)
  hallucinationCount Int   @default(0)
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([startedAt])
}

// Phase 4 SMOLAB Proposal 3.5 — Confidence calibration model.
// Logistic regression: calibrated = sigmoid(intercept + coef * rawConfidence).
// Trained by scripts/train-calibration.ts from EvalResult data. Applied in
// kb-access.ts calculateConfidence (later task) — falls back to raw when absent.
model CalibrationModel {
  id         String   @id @default("default")
  intercept  Float    @default(0)
  coef       Float    @default(1)
  trainedAt  DateTime @updatedAt
  sampleSize Int      @default(0)
}

// ===== RED TEAM ENGINE (Blueprint 2026-08-25) =====

/// RedTeamCase: một "vũ khí" trong kho tấn công. Khác EvalCase ở 2 điểm:
/// (1) có attackVector phân loại chiến thuật, (2) có origin truy vết được —
/// generated (sinh từ LLM), mutated (biến thể từ failure thật), hoặc curated
/// (viết tay). Failure đã biết → mutated cases kiểm tra phòng thủ còn vỡ không.
model RedTeamCase {
  id            String   @id @default(cuid())
  question      String
  /// Chiến thuật tấn công: hallucination_boundary | knowledge_poison |
  /// ambiguity_trap | injection_probe | domain_confusion | failure_mutation
  attackVector  String
  /// Mô tả cách attack TẠO RA case (prompt dùng, failure gốc nếu mutated)
  generationNote String  @default("")
  /// generated | mutated | curated
  origin        String   @default("generated")
  /// Model sinh case (vd kimi-k3) — truy vết tránh self-attack bias:
  /// model sinh case không được là model bị case đó nhắm vào
  generatedBy   String?
  ///active: sẵn sàng dùng | retired: đã bị phòng thủ hóa giải (giữ làm regression test)
  status        String   @default("active")
  /// Số lần case này VỠ qua phòng thủ (hệ thống trả lời sai). Tăng dần = tấn công mạnh
  breachCount   Int      @default(0)
  lastBreachAt  DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([attackVector, status])
  @@index([origin])
}

/// RedTeamRun: một đợt tấn công. 1-1 map với EvalRun (dùng chung runner)
/// nhưng tách bảng để không lẫn metrics học-tốt với metrics bị-tấn-công.
model RedTeamRun {
  id              String    @id @default(cuid())
  status          String    @default("running") // running | completed | failed
  caseCount       Int       @default(0)
  processedCount  Int       @default(0)
  /// Số case tấn công THÀNH CÔNG (hệ thống trả lời sai/bịa) — càng thấp càng tốt
  breachCount     Int       @default(0)
  /// Số case phòng thủ thành công (refuse đúng / trả lời đúng)
  defendedCount   Int       @default(0)
  /// Phân loại breach theo vector — cho biết loại tấn công nào hiệu quả nhất
  breachesByVector String   @default("{}") // JSON: {hallucination_boundary: 2, ...}
  avgLatencyMs    Int       @default(0)
  errorMessage    String?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?

  @@index([startedAt])
}

/// RedTeamResult: kết quả từng case trong run.
model RedTeamResult {
  id                String   @id @default(cuid())
  runId             String
  caseId            String
  /// Câu trả lời của hệ thống khi bị tấn công
  answer            String
  /// TRUE = tấn công thành công (phòng thủ vỡ). FALSE = phòng thủ đứng
  breached          Boolean  @default(false)
  /// Phán quyết của adversarial judge + defense judge
  attackVerdict     String   @default("{}")  // JSON {score, reasoning}
  defenseVerdict    String   @default("{}")  // JSON {score, reasoning}
  /// Có chunk nào bị dụ trả lời không (đo sức đề kháng retrieval)
  retrievedChunks   Int      @default(0)
  latencyMs         Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([runId])
  @@index([caseId])
}

/// DeletedSession (fix review 2026-09-08): tombstone PERSIST cho session đã
/// hard-delete. Tombstone in-process trước đây mất khi app restart — browser
/// tab còn giữ sessionId cũ gửi chat → upsert tạo lại row → "phiên đã xóa
/// hồi sinh". Row nhỏ (sessionId unique) — sống vô hạn, không cần dọn.
model DeletedSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  deletedAt DateTime @default(now())
}

/// ToolAssignment (Task 21-c): override quyền dùng tool THEO AGENT — enforce thật
/// tại prompt-side (workflow-engine/chat route) + executeTool hard-gate.
/// Row = override so với whitelist mặc định hardcoded:
///   enabled=true  → THÊM tool cho agent (kể cả tool ngoài whitelist mặc định)
///   enabled=false → VÔ HIỆU HÓA tool cho agent (chặn cả prompt lẫn executor)
///   (xóa row)     → về mặc định hardcoded
model ToolAssignment {
  id        String   @id @default(cuid())
  /// 'MEGATRON'|'SHOCWAVE'|'RAMPAGE'|'SENTINEL'|'CATALYST'|'OMEGA'|'NEW_AGENT'
  /// (NEW_AGENT = mọi agent động do Omega tạo — map 1 chiều tại tool-access.ts)
  agentKey  String
  toolName  String
  enabled   Boolean
  /// 'user' | 'omega' | 'system'
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentKey, toolName])
  @@index([agentKey])
}

/// FIX 2026-09-25 (E2E tool audit): skill-access.ts truy vấn SkillAssignment
/// bằng raw SQL nhưng table chưa từng được tạo trong schema (mọi list_skills/
/// read_skill đều log lỗi Prisma "no such table: SkillAssignment" dù fail-open).
/// Thêm model (mirror ToolAssignment, đổi toolName → slug) để Prisma client có
/// delegate + table thật — per-agent skill gating hoạt động sạch.
model SkillAssignment {
  id        String   @id @default(cuid())
  /// 'MEGATRON'|'SHOCWAVE'|'RAMPAGE'|'SENTINEL'|'CATALYST'|'OMEGA'|'NEW_AGENT'
  agentKey  String
  slug      String
  enabled   Boolean
  /// 'user' | 'omega' | 'system'
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentKey, slug])
  @@index([agentKey])
}

/// ToolConfig (Task 21-c): override MÔ TẢ tool builtin — đưa vào prompt LLM
/// (def.description) + hiển thị UI Tools Registry. KHÔNG đổi executor code.
model ToolConfig {
  id          String   @id @default(cuid())
  toolName    String   @unique
  /// Override description (≤2000 ký tự — đưa vào prompt LLM)
  description String?
  updatedBy   String?
  updatedAt   DateTime @updatedAt
}

/// ============================================================
/// EPISODIC MEMORY (A6 — file upload 2026-08-29)
/// Mirror SQLite bền của Episode/Lesson trên Neo4j (graph primary).
/// Episodic Neo4j layer là nguồn sự thật quan hệ (Episode-CONTAINS->Action,
/// Lesson-ABOUT->Concept...); 2 model này giữ data khi Neo4j drift/reset +
/// cho dashboard UI đọc nhanh. Ghi qua raw-SQL bridge (metrics-db pattern)
/// vì Prisma client trên dev server stale sau db:push.
/// ============================================================

/// EpisodeRecord — mirror node Episode (Neo4j) cho 1 task run hoàn chỉnh.
/// "Đã xảy ra gì, tôi làm gì, kết quả ra sao" — trải nghiệm, KHÔNG phải tri thức.
model EpisodeRecord {
  id             String    @id // "ep_<ts>_<rand>" — trùng id Neo4j + Qdrant point
  title          String
  goal           String
  contextSummary String
  /// SUCCESS | FAILURE | PARTIAL | ABANDONED
  outcome        String
  /// Độ tin của việc đánh giá outcome (evaluator confidence)
  confidence     Float     @default(0.5)
  /// OMEGA | RAMPAGE | SENTINEL...
  agent          String
  sessionId      String?
  /// 0-1 — dùng cho decay (×0.9/30 ngày không đụng) & retrieval ranking
  importance     Float     @default(0.8)
  accessCount    Int       @default(0)
  cycles         Int?
  tokensUsed     Int?
  toolCalls      Int?
  toolFailures   Int?
  /// complete | max_cycles | time_budget | token_budget | no_progress | cancelled | error
  stopReason     String?
  /// JSON array Action nodes: [{sequence, tool, inputSummary, reasoning, result, errorRef}]
  actionsJson    String?
  /// JSON array ErrorOccurrence: [{id, rawMessage, category, rootCause, resolved, fixSummary}]
  errorsJson     String?
  /// JSON array lesson ids yielded
  lessonsJson    String?
  /// Qdrant point id (collection theopus_episodes)
  embeddingId    String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([agent])
  @@index([outcome])
  @@index([createdAt])
}

/// LessonRecord — mirror node Lesson (Neo4j) — bài học TỒN TẠI VĨNH VIỄN
/// (không bao giờ decay). "Khi [trigger], nên [fix] vì [root_cause]".
model LessonRecord {
  id               String   @id // "lesson_<rand>" — trùng id Neo4j
  statement        String
  triggerCondition String?
  /// R1..R6 taxonomy code
  rootCause        String?
  /// JSON array string: ["refactor","typescript",...]
  appliesTo        String?
  /// SELF_DERIVED | USER_TAUGHT | SUBAGENT_REPORT
  source           String   @default("SELF_DERIVED")
  /// ≥0.7 auto-apply | <0.4 cần user review
  confidence       Float    @default(0.6)
  timesApplied     Int      @default(0)
  timesValidated   Int      @default(0)
  timesFailed      Int      @default(0)
  needsReview      Boolean  @default(false)
  /// Qdrant point id (dùng cho similarity merge check > 0.85)
  embeddingId      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([confidence])
  @@index([needsReview])
  @@index([rootCause])
}

// ============================================================================
// SELF-DIRECTION MODULE (2026-09-12)
// Agents tự phát hiện khoảng trống (thiếu gì? học gì? KB mâu thuẫn? tool hay
// fail? skill thiếu? test chưa có?) → tự đặt mục tiêu, tự đề xuất kế hoạch
// triển khai + thời điểm triển khai → gửi Mr. Architect phê duyệt (hoặc ủy
// quyền cho Omega duyệt). Được duyệt → Omega orchestrate: lập kế hoạch bước,
// giao việc agents, theo dõi bàn giao, đánh giá hoàn thành, viết báo cáo.
// ============================================================================

/// Đề xuất/kế hoạch do hệ thống (scan), agents hoặc user tạo — chờ phê duyệt.
model SelfDirectionProposal {
  id              String    @id @default(cuid())
  title           String
  /// gap | kb_contradiction | tool_failure | missing_skill | missing_test | improvement | long_term
  category        String    @default("improvement")
  /// low | medium | high | critical
  priority        String    @default("medium")

  // ===== Nội dung đề xuất (bắt buộc rõ ràng 4 phần) =====
  /// Vấn đề là gì?
  problem         String
  /// Giải quyết như thế nào?
  solution        String
  /// Triển khai như thế nào?
  implementation  String
  /// Thời điểm triển khai là gì? (null = triển khai ngay khi được duyệt)
  scheduleAt      DateTime?
  /// Tác động kỳ vọng
  impact          String?

  // ===== Trạng thái phê duyệt + triển khai =====
  /// pending | approved | rejected | ready | planning | executing | completed | failed
  status          String    @default("pending")
  /// scan | agent | user | omega
  source          String    @default("scan")
  /// llm | code-workflow — chế độ thực thi khi được duyệt (CI-6 B5):
  /// 'llm' = các bước chạy thuần hội thoại LLM (mặc định, tương thích ngược);
  /// 'code-workflow' = agents chỉnh sửa code THẬT trong workspace qua tool
  /// executor + bước cuối verify_and_push chạy pipeline kiểm định 9 bước thật
  executionMode   String    @default("llm")
  createdBy       String    @default("self-direction-scan")

  // ===== AUTOMATION PROPOSAL (user request 2026-09-13) =====
  // category='automation' — đề xuất tạo cron job / webhook / standing order /
  // task flow do agent đề xuất qua propose_automation (Omega chuyển tiếp) hoặc
  // user tạo tay. JSON {kind, payload, proposedBy}. Được duyệt →
  // executeAutomationProposal() tạo tài nguyên THẬT (fast-path, không cần
  // Omega orchestration giao agents — hành động thuần cơ khí).
  automationJson  String?

  // ===== Mr. Architect / Omega review =====
  /// Ghi chú / yêu cầu bổ sung của Mr. Architect (user)
  userNotes        String?
  /// mr-architect | omega (khi được ủy quyền duyệt)
  reviewer         String?
  /// Lý do từ chối hoặc lý do Omega duyệt/bỏ duyệt
  decisionReason   String?
  reviewedAt       DateTime?

  // ===== Omega orchestration =====
  /// Tóm tắt kế hoạch do Omega lập (sau khi được duyệt)
  planSummary      String?
  /// Báo cáo hoàn thiện do Omega viết (markdown): đã làm gì, làm thế nào,
  /// kết quả từng bước, kết quả sau cùng, đề xuất thêm
  omegaReport      String?
  executedAt       DateTime?
  completedAt      DateTime?

  // ===== OPUS FOLLOW-UP (user directive 2026-09-04) =====
  // Sau khi đề xuất hoàn tất (completed/failed) và Omega viết BÁO CÁO HOÀN
  // THIỆN, OPUS (CTO) xem phần "Ý kiến & đề xuất khác" trong báo cáo → tự
  // quyết định có tạo ĐỀ XUẤT PHÁI SINH tới SELF-DIRECTION hay không.
  /// Thời điểm Opus đã xem xét ý kiến & đề xuất khác trong báo cáo (null = chưa)
  opusFollowUpAt        DateTime?
  /// Kết quả xem xét của Opus (trace ngắn: tạo đề xuất phái sinh <id> / lý do không tạo)
  opusFollowUpResult    String?
  /// Đề xuất cha nếu đây là đề xuất phái sinh do Opus tạo từ báo cáo (null = đề xuất gốc)
  followUpParentId      String?
  /// Độ sâu chuỗi phái sinh (gốc=0) — cap chống vòng lặp vô hạn
  followUpDepth         Int       @default(0)

  // ===== TASK 32 (2026-09-27) — 2 CƠ CHẾ MỚI CHO SELF-DIRECTION =====
  // (1) Opus duyệt 3 MỨC (mechanism 1): approve (cần thiết toàn bộ) |
  //     approve_partial (chỉ 1 phần cần làm → Opus TỰ CHỈNH SỬA nội dung đề
  //     xuất thu hẹp về đúng phần cần thiết RỒI duyệt bản đã chỉnh) | reject.
  //     reviewEdits lưu lịch sử chỉnh sửa khi duyệt (before/after + scopeNote)
  //     — audit đầy đủ cho Mr. Architect đối chiếu.
  /// Lịch sử Opus chỉnh sửa đề xuất khi duyệt approve_partial (JSON array:
  /// [{at, reason, scopeNote, before:{title,problem,solution,implementation,impact},
  ///   after:{...}}])
  reviewEdits     Json?
  // (2) Omega re-plan giữa chừng (mechanism 2): sau MỖI bước hoàn thành, Omega
  //     đánh giá lại các bước CÒN LẠI — keep (giữ) | adjust (đổi nội dung công
  //     việc HOẶC đổi agent) | drop (bước thừa) | newSteps (việc mới phát
  //     sinh). replanHistory lưu mỗi lần điều chỉnh THẬT (sau bước nào, đổi
  //     gì, tại sao) — traceability đầy đủ.
  /// Lịch sử Omega điều chỉnh kế hoạch sau mỗi bước hoàn thành (JSON array:
  /// [{at, afterStepOrder, afterStepTitle, afterStepAssignee, reason,
  ///   changes:[{action, stepOrder?, old?, new?, rationale}]}])
  replanHistory   Json?

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  steps            ProposalStep[]

  @@index([status])
  @@index([opusFollowUpAt])
  @@index([createdAt])
  @@map("self_direction_proposals")
}

/// 1 bước trong kế hoạch triển khai do Omega lập — giao cho agent/team thực hiện.
model ProposalStep {
  id          String    @id @default(cuid())
  proposalId  String
  stepOrder   Int
  title       String
  description String
  /// Agent thực hiện (tên trong roster) hoặc "Omega"
  assignee    String
  /// pending | in_progress | done | failed
  status      String    @default("pending")
  /// Output agent trả về sau khi thực hiện bước này
  output      String?
  /// Đánh giá của Omega về output (đã thật sự hoàn thành chưa?)
  evaluation  String?
  /// Số lần thử lại khi Omega đánh giá chưa đạt (max 3)
  attempts    Int       @default(0)
  /// Biên lai thực thi THẬT trong workspace (CI-6 B5): bước cuối code-workflow
  /// lưu PrePushResult (pipeline 9 bước lint→…→pull); bước giữa lưu tool-call
  /// receipts (executeTool thật). null = bước chạy chế độ llm thuần hội thoại.
  workspaceReceipt Json?
  startedAt   DateTime?
  finishedAt  DateTime?
  /// Prisma tự update ở MỌI lần ghi (attempts/output/evaluation...) — dùng làm
  /// tín hiệu sống cho stall-detection: step đang rework vẫn "còn sống".
  updatedAt   DateTime  @default(now()) @updatedAt

  proposal    SelfDirectionProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)

  @@index([proposalId, stepOrder])
  @@map("proposal_steps")
}

/// Cài đặt singleton của module Self-direction (đơn giản hóa: 1 row id='singleton').
model SelfDirectionSettings {
