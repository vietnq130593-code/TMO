// ============================================================================
// CI-5 (GĐ4, Task 14-a) — DURABLE GOAL LOOP (GoalLoopJob)
// ============================================================================
// DB LÀ QUEUE của kiến trúc durable goal loop (contract types:
// src/lib/goal-loop-durable-types.ts — worker: src/lib/goal-loop-worker.ts):
// POST /api/openclaw/chat → enqueue job (status='queued') → trả jobId ngay →
// GoalLoopWorker nền tick 5s claim job bằng updateMany conditional (atomic
// lock) → chạy tối đa 2 job song song → checkpoint SAU MỖI VÒNG (resume
// granularity 1 vòng) → hoàn thành hoặc recover sau restart (orphan sweep:
// job DB-running KHÔNG nằm trong running-map của process = mồ côi → requeue
// nếu attempts < maxAttempts, else failed). Cancel qua DB flag
// cancelRequestedAt — nút Dừng sống sót qua restart, KHÔNG phụ thuộc RAM.

// ============================================================================
// OPUS — CTO META-AGENT (user request 2026-09-30)
// ============================================================================
// Opus là CTO của TMO: KHÔNG tự thi công — chỉ phán đoán GIỮA các run và chỉ
// đạo bước tiếp theo. Sau mỗi run (agent đơn / team workflow / delegation),
// Opus đọc dossier (yêu cầu gốc + Thought Progress + kết quả cuối + bằng chứng
// kiểm định + issue ledger) → verdict theo 5 động từ CONTINUE/FIX/REDIRECT/
// ESCALATE/STOP. Chế độ auto: Opus tự hành động thay user, chỉ dừng khi
// predicate 4 điều kiện thỏa (spec gốc đạt + ledger sạch blocking/major +
// chuỗi kiểm định xanh + vòng quét cuối không mở issue blocking mới).

/// 1 bản review của Opus cho 1 agent run đã hoàn thành (manual hoặc auto).
model OpusReview {
  id           String   @id @default(cuid())
  sessionId    String   /// AgentSession.sessionId
  /// runId (run_xxx / sub_xxx delegation) của run đang được review
  runRef       String?
  /// ChatMessage id của assistant message cuối cùng của run (neo UI)
  messageId    String?
  /// CONTINUE | FIX | REDIRECT | ESCALATE | STOP (giao thức 5 động từ)
  decision     String
  /// JSON OpusVerdict đầy đủ: { summary, axes{...}, issues[], directive,
  ///   rationale, evidenceRefs[], stopAssessment{...} } — xem src/lib/opus/
  verdict      String?  /// JSON
  /// manual | auto — chế độ kích hoạt review này
  triggerMode  String   @default("manual")
  model        String?  /// model thực tế trả verdict (kimi-k3 hoặc fallback)
  tokensUsed   Int?
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([sessionId, createdAt])
  @@index([runRef])
  @@index([decision])
}

/// OPUS — Issue Ledger: sổ công nợ vấn đề Opus ghi nhận qua các vòng review.
/// Predicate dừng (auto mode) tra sổ này: không còn issue blocking/major OPEN
/// là 1 trong 4 điều kiện bắt buộc.
model IssueLedger {
  id           String    @id @default(cuid())
  sessionId    String
  /// runId mở ra issue (run_xxx / sub_xxx)
  runRef       String?
  /// OpusReview.id phát hiện issue
  opusReviewId String?
  title        String
  /// blocking | major | minor | nit
  severity     String
  /// open | fixed | wont_fix | superseded
  status       String    @default("open")
  /// trích dẫn bằng chứng (tool output / dòng log / diff hunk) — BẮT BUỘC có
  evidence     String?
  openedAt     DateTime  @default(now())
  resolvedAt   DateTime?
  /// opus_review id xác nhận đã sửa | 'user' khi user tự đóng
  resolvedBy   String?

  @@index([sessionId, status])
  @@index([severity])
}

/// OPUS — cài đặt toàn hệ thống (singleton). Kill switch là PHANH DUY NHẤT còn
/// lại khi auto mode chạy không giới hạn vòng/budget (user decision #2) —
/// được đọc ở MỖI vòng trước khi Opus tự hành động tiếp.
model OpusSettings {
  id        String    @id @default("singleton")
  /// true = KILL SWITCH — auto mode ngưng toàn hệ thống tới khi user bật lại
  killed    Boolean   @default(false)
  killedAt  DateTime?
  updatedAt DateTime  @updatedAt

  @@map("opus_settings")
}

/// 1 job goal-loop chạy nền — sống sót qua restart/đóng tab (durable).
model GoalLoopJob {
  id                String    @id @default(cuid())
  sessionId         String    /// AgentSession.sessionId — phiên chat gốc
  messageId         String?   /// ChatMessage.id của user message trigger (nullable)
  status            String    @default("queued") /// queued | running | completed | failed | cancelled (GoalLoopJobStatus)
  /// Input đầy đủ để re-run sau restart — JSON GoalLoopJobInput (goal-loop-durable-types.ts)
  input             String
  cyclesDone        Int       @default(0)
  /// JSON GoalLoopCheckpoint — snapshot mỗi vòng lặp (đã bounded bởi CI-3 compression ~50k chars)
  checkpoint        String?
  /// JSON GoalLoopResult khi completed (content final + metadata)
  result            String?
  stopReason        String?
  error             String?
  attempts          Int       @default(0) /// số lần requeue sau crash; chết vĩnh viễn khi >= maxAttempts
  /// Nút Dừng qua DB flag — worker cancelCheck đọc field này, KHÔNG phụ thuộc RAM
  cancelRequestedAt DateTime?
  /// Tín hiệu sống cuối (mỗi vòng + mỗi tool batch) — stall warning UI khi stale
  heartbeatAt       DateTime?
  /// ID process đang chạy job (os.pid) — observability
  workerPid         Int?
  createdAt         DateTime  @default(now())
  startedAt         DateTime?
  completedAt       DateTime?
  updatedAt         DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([sessionId, createdAt])
}

