# ============================================
# GraphRAG Knowledge Base — Environment Configuration
# ============================================
# Architecture: SQLite (buffer) → Qdrant (vector+document) + Neo4j (graph)
#
# Prerequisites:
#   1. ZEN_API_KEY_1 — key OpenCode Zen (REQUIRED — toàn bộ lõi LLM chạy Zen;
#      NVIDIA NIM chỉ còn lõi embed cho Knowledge Base)
#   2. Qdrant vector database running on localhost:6333 (REQUIRED for KB)
#   3. Neo4j running on localhost:7687 (OPTIONAL — only for Knowledge Graph)
#
# Setup:
#   cp .env.example .env
#   # Fill in your API keys (ZEN_API_KEY_1/2 + NVIDIA embed keys nếu dùng KB)
#   bun install      # postinstall tự chạy prisma generate
#   bun run setup    # prisma generate + db:push (tự tạo db/custom.db) + bật
#                    # git hooks quality gate (pre-push/pre-merge-commit).
#                    # Chỉ cần `bun run db:push` nếu không muốn bật hooks.
#                    # Máy yếu / đang chạy dev: tạo file .quality-gate.local
#                    # với dòng skipBuild=true để gate bỏ bước build thử.
#   bun run dev      # Start the development server on port 3000
# ============================================

# ============================================
# DATABASE (Prisma SQLite — local buffer layer)
# ============================================
# QUAN TRỌNG (Portability): dùng đường dẫn TƯƠNG ĐỐI như bên dưới để khi copy
# thư mục app sang vị trí khác, bản copy tự dùng file DB riêng của nó.
# Nếu dùng đường dẫn TUYỆT ĐỐI (vd file:/home/.../db/custom.db hoặc
# file:C:/Users/.../db/custom.db), bản copy vẫn trỏ về DB ở vị trí CŨ →
# dữ liệu KHÔNG đi kèm theo thư mục.
# Khi copy: STOP app trước (WAL mode — dữ liệu mới nhất có thể nằm trong
# custom.db-wal; copy đủ 3 file custom.db + custom.db-wal + custom.db-shm).
DATABASE_URL=file:../db/custom.db

# ============================================
# FILE STORAGE
# Upload directory for PDF files (default: /tmp/theopus-uploads)
# ============================================
# UPLOAD_DIR=/tmp/theopus-uploads

# ============================================
# QDRANT CONFIGURATION (Vector Database)
# Handles: Document metadata, Chunk text+embeddings, Semantic search
# Install: Download binary from https://github.com/qdrant/qdrant/releases
# Start:   ./qdrant --config-path qdrant-config.yaml
# Config:  See qdrant-config.yaml in project root
# Collections are auto-created on first health check or via POST /api/setup/qdrant
# ============================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_DOCUMENTS=theopus_documents
QDRANT_COLLECTION_CHUNKS=theopus_chunks

# ============================================
# NEO4J CONFIGURATION (Graph Database) — OPTIONAL
# Handles: Entities, Relationships, Knowledge Graph traversal
# If not running, the app still works fine (chat, agents, skills, memory)
# Only needed if you want Knowledge Graph features
#
# === SETUP WITH NEO4J DESKTOP ===
# 1. Download & install: https://neo4j.com/download/
# 2. Open Neo4j Desktop → Create new Project → Add Database → Start
# 3. Set password when prompted (remember it for NEO4J_PASSWORD below)
# 4. Default bolt port: 7687, HTTP: 7474
# 5. IMPORTANT: Use bolt:// (NOT neo4j://) for Desktop single-instance
#    - bolt://127.0.0.1:7687  ← CORRECT for Desktop
#    - neo4j://127.0.0.1:7687 ← WRONG (causes "Could not perform discovery" error)
#
# === SETUP WITH DOCKER ===
# docker run -d --name neo4j -p 7474:7474 -p 7687:7687 \
#   -e NEO4J_AUTH=neo4j/your-password neo4j:latest
#
# === SETUP WITH NEO4J AURADB (Cloud) ===
# Change URI to: neo4j+s://<instance-id>.databases.neo4j.io
#
# ⚠ NEO4J_DATABASE trên AuraDB: tên DB do Aura đặt khi tạo instance — THƯỜNG
#   = instance-id (vd "6e688b02"), KHÔNG phải "neo4j". Xem tên thật:
#   console.neo4j.io → instance → Connect (hoặc chạy SHOW DATABASES).
#   Đặt sai tên → lỗi "Unable to get a routing table for database 'neo4j'
#   because this database does not exist" (trong khi DNS + port Bolt + auth
#   đều bình thường — đừng tưởng mạng/instance down).
#
# === VERIFY CONNECTION ===
# Open browser: http://localhost:7474 — should show Neo4j Browser
# ============================================
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password-here
# Desktop/Docker: "neo4j" — AuraDB: tên DB thật của instance (xem ⚠ phía trên)
NEO4J_DATABASE=neo4j

# ============================================
# NVIDIA NIM API CONFIGURATION (4 keys for rotation)
# Architecture: NVIDIA NIM ONLY (single provider)
#   - 2 extraction cores: llama-3.3-70b, gpt-oss-120b
#   - 5 agent/chat cores: deepseek-v4-pro, kimi-k2.6, glm-5.1, minimax-m2.7, qwen3.5-397b
#   - NOT using: deepseek-v4-flash
# Get keys: https://build.nvidia.com/
# Rate limit: 40 RPM per key, no daily cap
# Auto mode: 4 keys × 4 docs/key = 16 max concurrent documents
# ============================================
NVIDIA_API_KEY_1=your-nvidia-key-1
NVIDIA_API_KEY_2=your-nvidia-key-2
NVIDIA_API_KEY_3=your-nvidia-key-3
NVIDIA_API_KEY_4=your-nvidia-key-4

# NVIDIA Embedding Model Configuration
# Model: nvidia/llama-nemotron-embed-1b-v2 (Matryoshka, supports dynamic dimensions)
# Previous model nvidia/embed-qa-4 is DEPRECATED (returns 404)
NVIDIA_EMBED_MODEL=nvidia/nemotron-3-embed-1b
NVIDIA_EMBED_DIMENSIONS=2048

# ============================================
# OPENCODE ZEN PROVIDER (phiên 7 — Task 37)
# ============================================
# OpenCode Zen — toàn bộ lõi LLM của TMO (agents + chat + utility + extraction).
# Base URL: https://opencode.ai/zen/v1 · Phân bổ model PHIÊN 7 (seed tự sync
# mỗi boot): TẤT CẢ 13 agents = space-bunny-free — model free DUY NHẤT còn mở
# cho oc_sk API key sau policy Zen ~25-26/09 (verified 28/10: nemotron-ultra /
# muse-spark / lightning → 403 FreeTierError ở cả 2 key, HTTP lẫn CLI type:api).
#
# ⚠ CHUỖI RUNTIME: Zen HTTP (403 fast-fail, cache skip 15p) → OpenCode CLI
#   (chỉ có tác dụng khi CLI đăng nhập ACCOUNT — 'opencode auth login' oauth)
#   → ZEN FAILOVER space-bunny-free → trả lỗi rõ ràng (KHÔNG fallback NIM).
#   Muốn dùng lại nemotron-3-ultra-free / muse-spark-1.3-contributor-free:
#   cài opencode CLI (Windows: irm https://opencode.ai/install.ps1 | iex) +
#   'opencode auth login' (đăng nhập account OpenCode — như máy Hermet).
#
# 2-key rotation pool (mark 429 → 60s cooldown, switch to other key).
# Get keys: https://opencode.ai (sign up → dashboard → API keys)
# ============================================
ZEN_BASE_URL=https://opencode.ai/zen/v1
ZEN_API_KEY_1=your-zen-key-1
ZEN_API_KEY_2=your-zen-key-2
ZEN_TIMEOUT_MS=120000
# (Tùy chọn — mặc định code đã đúng, chỉ đặt khi muốn ghi đè)
# ZEN_FAILOVER_MODEL=space-bunny-free   # model đích khi cả HTTP + CLI đều fail
# ZEN_FREE_TIER_CACHE_MS=900000         # TTL cache model bị chặn (0 = tắt)
# ZEN_REASONING_EFFORT=                 # trống = tự động theo model (muse=xhigh, space-bunny=max)
# OPENCODE_CLI_ENABLED=true             # bật đường CLI fallback
# OPENCODE_CLI_BIN=                     # trống = auto-detect (Windows: %USERPROFILE%\.opencode\bin\opencode.exe / npm opencode.cmd / PATH)
# OPENCODE_CLI_TIMEOUT_MS=240000

# Auto-Learn Cold Start Protection (Phase 2 SMOLAB Proposal 4.4)
# Fresh-install safety: skip auto-learn until KB has enough seed data,
# otherwise every query's unverified LLM output pollutes KB in the first hours.
# COLD_START_INSIGHT_THRESHOLD: below this insight count → never auto-learn
# CONSERVATIVE_INSIGHT_THRESHOLD: below this → require higher confidence (CONSERVATIVE_CONFIDENCE_MIN)
COLD_START_INSIGHT_THRESHOLD=100
CONSERVATIVE_INSIGHT_THRESHOLD=500
CONSERVATIVE_CONFIDENCE_MIN=0.7

# REMOVED: Mistral, Cerebras, OpenRouter are no longer used.
# Only NVIDIA NIM is configured as the single LLM provider.
# These env vars are ignored if present:
# MISTRAL_API_KEY_1..4
# CEREBRAS_API_KEY_1..4
# OPENROUTER_API_KEY_1..4
# ENABLE_CEREBRAS

# ============================================
# OPENCLAW GATEWAY CONFIGURATION
# Self-hosted AI Agent Gateway — runs on port 18789
# Optional: If not running, the app falls back to direct LLM provider calls
# Get: https://github.com/agenthub/openclaw
# ============================================
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_AUTH_MODE=none

# ON-DEMAND MODE (mặc định true): KHÔNG spawn gateway lúc app khởi động —
# gateway chỉ lazy-start khi một tính năng thật sự cần nó (chat fallback cho
# agent không có provider/model, Channels, skills/sessions listing...) và tự
# tắt sau thời gian idle. Tiết kiệm ~340MB RAM idle (và nhiều hơn khi gateway
# có session đang hoạt động). Đặt false để quay lại chế độ luôn-start-như-cũ.
# Lưu ý: trên Windows local gateway không chạy được (binary symlink POSIX) —
# chế độ on-demand giúp app khởi động sạch hơn, không còn loop lỗi spawn.
OPENCLAW_ON_DEMAND=true
# Tự tắt gateway sau N ms không dùng đến (0 = không tự tắt; mặc định 10 phút)
OPENCLAW_IDLE_SHUTDOWN_MS=600000
# Thời gian chờ tối đa gateway health OK sau khi spawn on-demand (mặc định 45s)
OPENCLAW_SPAWN_TIMEOUT_MS=45000

# ============================================
# GOAL LOOP — CONTEXT COMPRESSION (rolling digest, user request 2026-09-08)
# Mỗi vòng lặp gửi TOÀN BỘ transcript cho LLM → chi phí prompt tích luỹ O(n²).
# Khi tổng ký tự messages vượt ngưỡng, phần cũ được NÉN thành 1 digest message
# (~2.5k chars) bằng LLM utility core (rẻ), giữ system + goal + N message gần
# nhất. Digest cũng ghi vào WorkingMemory (HOT) để request sau đọc lại.
# ============================================
# Ngưỡng tổng ký tự messages để kích hoạt nén (code mặc định 50000; Task D 2026-10-30
# hạ còn 24000 — halve transcript budget: steady-state transcript ~nửa cũ)
GOAL_LOOP_COMPRESS_THRESHOLD_CHARS=24000

# ROUND-23 P7 — cap số messages giữ giữa các chu kỳ goal-loop (mặc định 48)
# GOAL_LOOP_MAX_MESSAGES=48

# ROUND-23 P4 — ring buffer agent event bus (mặc định 300)
# AGENT_EVENT_RING_MAX=300
# Số message gần nhất giữ nguyên khi nén (code mặc định 8; Task D 2026-10-30 hạ còn 5)
GOAL_LOOP_KEEP_RECENT_MESSAGES=5
# Cap ký tự của digest sau nén (mặc định 2500)
GOAL_LOOP_DIGEST_MAX_CHARS=2500

# ============================================
# GOAL LOOP — NATIVE TOOLS (Task D — token efficiency 2026-10-30, theo điều tra Task B)
# Model hiện tại (space-bunny-free) trả 0 native tool_calls qua HTTP — bỏ qua
# body.tools (34 schema JSON ~7k tokens gửi mỗi vòng = dead weight). Đường hành
# động hoạt động là text protocol ("tool_call: ..." parse bởi
# parseToolCallsFromOutput) dùng compact schema block TRONG system prompt.
# 0 (mặc định) = KHÔNG gửi body.tools cho call agent goal-loop (~7k tok/vòng tiết kiệm).
# 1 = gửi body.tools như trước (dùng khi model thật sự hỗ trợ native FC).
# Đọc lúc bắt đầu mỗi run goal-loop (sửa .env thì cần restart app để nạp lại).
# ============================================
TMO_GOAL_LOOP_NATIVE_TOOLS=0

# ============================================
# GOAL LOOP — BUDGET (CI-1 unlimited mode, Mr. Architect request 2026-09-11)
# QUY ƯỚC: 0 = KHÔNG GIỚI HẠN. Phanh an toàn thay thế budget: no_progress
# (3 chu kỳ liên tiếp KHÔNG có tool call thành công nào → dừng + báo cáo).
# ============================================
# Token budget toàn goal loop (TASK 21: mặc định 0 = KHÔNG giới hạn — NVIDIA NIM unlimited token; 0 = không giới hạn)
GOAL_LOOP_TOKEN_BUDGET=0
# Thời gian toàn goal loop ms — user request 2026-09-13: trần 12 GIỜ (43200000; mặc định code = 12h; 0 = không giới hạn)
GOAL_LOOP_TIME_BUDGET_MS=43200000
# Số chu kỳ PLAN→EXECUTE→VERIFY→EVALUATE tối đa (mặc định 4; 0 = không giới hạn)
GOAL_LOOP_MAX_CYCLES=0
# Số vòng ReAct tối đa mỗi chu kỳ (mặc định 10; 0 = không giới hạn)
GOAL_LOOP_ITERATIONS_PER_CYCLE=0
# Phanh TRONG chu kỳ khi ITER=0 + TOKEN=0 (∞) — review R2-b #1: N vòng liên tiếp
# không tool-call thành công → cắt chu kỳ; fingerprint lặp (check mỗi N vòng)
# → cắt chu kỳ. 0 = tắt.
GOAL_LOOP_IN_CYCLE_STALL_ITERATIONS=12
GOAL_LOOP_IN_CYCLE_FP_CHECK_EVERY=10
GOAL_LOOP_IN_CYCLE_FP_MAX_REPEATS=3
# TASK 21 (2026-09-30) + TASK 22 — trọng tài KHÔNG phán kết thúc vội khi còn
# việc dở: số chu kỳ debt xử lý "lỗi phát sinh liên quan" tối đa / run
# (nâng 3 → 100 theo user directive "cho phép max 100 chu kỳ"; 0 = off)
GOAL_LOOP_MAX_DEBT_CYCLES=100
# TASK 21 + TASK 22 — số lần TÁI LẬP CỬA SỔ CHU KỲ khi hết trần chu kỳ mà mục
# tiêu chưa hoàn thành triệt để / còn lỗi phát sinh chưa xử lý (nâng 2 → 100;
# 0 = không tái lập; chỉ áp dụng khi GOAL_LOOP_MAX_CYCLES > 0)
GOAL_LOOP_MAX_CYCLE_RENEWALS=100

# ============================================
# GĐ4 CI-5: DURABLE GOAL LOOP (Task 14-a)
# POST chat → enqueue GoalLoopJob (DB) → trả jobId ngay → GoalLoopWorker nền
# chạy job, checkpoint mỗi vòng (RESUME từ vòng gần nhất sau kill -9/restart),
# nút Dừng qua DB flag sống sót qua đóng tab. Chi tiết: src/lib/goal-loop-
# worker.ts + contract types src/lib/goal-loop-durable-types.ts.
# ============================================
# Bật kiến trúc bền vững: POST chat → enqueue job → worker nền chạy,
# checkpoint mỗi vòng, sống sót qua restart/đóng tab. Off = hành vi
# inline cũ 100% (rollout an toàn theo roadmap B5).
ENABLE_DURABLE_GOAL_LOOP=false
# Số job goal-loop chạy đồng thời tối đa (Mr. Architect chốt: 2)
GOAL_LOOP_MAX_CONCURRENT=2
# Chu kỳ tick của worker (ms) — 0 = tắt worker hẳn
GOAL_LOOP_WORKER_TICK_MS=5000
# Heartbeat stale quá ngưỡng này → UI cảnh báo stall (job vẫn chạy —
# LLM call hợp lệ tối đa 8' + tool time; KHÔNG auto-kill job trong process)
GOAL_LOOP_STALL_WARN_MS=900000
# Số lần requeue tối đa sau crash trước khi job chết vĩnh viễn
GOAL_LOOP_MAX_ATTEMPTS=2
# Throttle ghi checkpoint / heartbeat vào DB (ms)
GOAL_LOOP_CHECKPOINT_MIN_INTERVAL_MS=3000
GOAL_LOOP_HEARTBEAT_MIN_INTERVAL_MS=15000
# Timeout mỗi LLM call trong 1 agent step của Code Team workflow-engine
# (Task 14-d — CI-5 B6): 4 phút → 8 phút mặc định — lượt suy luận/biến đổi lớn
# (TL recon 30K-token context) không bị cắt giữa chừng. Lỗi transient
# (timeout/network/429/5xx) được retry tối đa 2 lần (backoff 5s/15s) ngay
# trong step; stall-kill self-direction tôn trọng tín hiệu sống (tool
# receipt/heartbeat) trước khi giết orchestration > 10 phút.
AGENT_STEP_TIMEOUT_MS=480000

# ============================================
# SUB-AGENT DELEGATION (delegate_task — user request 2026-09-08)
# Agent (vd Omega) delegate task cho Code Team chuyên trách (MEGATRON/SHOCWAVE/
# RAMPAGE/SENTINEL/CATALYST). Sub-agent chạy mini ReAct loop có budget RIÊNG,
# parent chỉ nhận báo cáo nén (context isolation → tiết kiệm budget token).
# ============================================
# Bật/tắt tool delegate_task (mặc định true)
ENABLE_SUBAGENT_DELEGATE=true
# Số vòng LLM tối đa mỗi sub-agent (mặc định 5; 0 = không giới hạn)
SUBAGENT_MAX_ITERATIONS=0
# Trần cứng dự phòng chỉ áp dụng khi CẢ 3 cap = 0 (mặc định 200; 0 = TẮT hẳn —
# sub-agent chạy VÔ HẠN thật, dừng bởi conclude / cancel / error)
SUBAGENT_HARD_CEILING_ITERATIONS=0
# Token budget riêng MỖI lần delegate (mặc định 40000; 0 = không giới hạn)
SUBAGENT_TOKEN_BUDGET=0
# Timeout toàn bộ 1 lần delegate (mặc định 480000ms = 8 phút; 0 = không giới hạn)
SUBAGENT_TIMEOUT_MS=0

# ============================================
# OPENCODE SERVER CONFIGURATION
# AI Coding Agent Server — runs on port 18790
# Custom Hono HTTP server providing file ops, bash, LSP, MCP bridge
# Used by Code Team agents for code operations (read/write/bash)
# If not running, agents fall back to direct file system operations
# ============================================
OPENCODE_SERVER_URL=http://127.0.0.1:18790
OPENCODE_SERVER_PORT=18790
# Set to the absolute path of your project directory on your machine
OPENCODE_WORKSPACE=.

# ============================================
# CODE TEAM SKILLS — Web Search & Reader APIs
# Multi-key rotation with automatic fallback on rate limit/auth errors
# (2026-10-15) z-ai-web-dev-sdk fallback ĐÃ GỠ BỎ — chỉ dùng direct API keys
# ============================================

# Tavily: AI-optimized deep web search for AI Agents (4 keys for rotation)
# Rate limit: ~1000 requests/month per key
TAVILY_API_KEY_1=your-tavily-key-1
TAVILY_API_KEY_2=your-tavily-key-2
TAVILY_API_KEY_3=your-tavily-key-3
TAVILY_API_KEY_4=your-tavily-key-4

# Jina Reader: Read and extract content from any web page (2+ keys for rotation)
# Rate limit: 1M tokens/month per key
JINA_API_KEY_1=your-jina-key-1
JINA_API_KEY_2=your-jina-key-2

# Serper: Google Search API for programmatic search (4 keys for rotation)
# Rate limit: 25,000 searches/month per key
SERPER_API_KEY_1=your-serper-key-1
SERPER_API_KEY_2=your-serper-key-2
SERPER_API_KEY_3=your-serper-key-3
SERPER_API_KEY_4=your-serper-key-4

# ============================================
# APPLICATION BASE URL
# Used for internal API calls (knowledge bridge, etc.)
# In development, this is typically http://localhost:3000
# In production, set to your actual domain
# ============================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ============================================
# v2.1 FEATURE FLAGS — Staged rollout for new tools
# See: docs/FULLSTACK_CAPABILITY_PLAN_V2.md Part 12
#
# ⚠️ QUAN TRỌNG KHI CHẠY LOCAL (bug report 2026-08-30): nếu bạn copy .env từ
# bản CŨ, các flag dưới đây có thể đang =false → shell/todo/mcp/web bị TẮT dù
# runtime probe trông có vẻ OK. Đảm bảo 4 flag lõi này =true:
#   ENABLE_SHELL_TOOL / ENABLE_TODO_TOOL / ENABLE_MCP_CALL / ENABLE_WEB_UNIFIED
# (Nếu xóa dòng flag → code default tự bật 4 flag lõi này.)
# ============================================
# Phase 1a (low-risk foundation)
ENABLE_SHELL_TOOL=true  # agent chạy lệnh shell; cwd mặc định workspace root (absolute OK), không chặn lệnh
ENABLE_TODO_TOOL=true
ENABLE_QUALITY_GATE=off  # off | warn | strict

# Phase 1b (web + gateway — not yet implemented)
ENABLE_WEB_UNIFIED=true  # web_search/web_fetch (multi-strategy: Tavily→Serper / Jina — direct API keys only; z-ai-sdk đã gỡ 2026-10-15)
ENABLE_GATEWAY_TOOLS=off  # off | phase-1b | full

# Phase 1c (native function calling — implemented, default dual for 1 sprint validation)
ENABLE_NATIVE_FC=dual  # off | dual | strict (dual = native preferred + regex fallback)

# Phase 2 (file ops — already shipped in commit 337f56f, default on)
# Per-tool flags per spec — flip individual tool off without disabling the whole suite.
ENABLE_FILE_OPS=true         # master switch — false disables ALL file_* tools below
ENABLE_FILE_READ=true        # file_read (Claude Code parity: line numbers + offset + limit + truncation cursor)
ENABLE_FILE_EDIT=true        # file_edit (atomic + match_count guard + dry_run)
ENABLE_FILE_MULTI_EDIT=true  # file_multi_edit (atomic batch — wraps file_edit with edits[])
ENABLE_FILE_DELETE=true       # file_delete (dry_run + repo root guard)
ENABLE_FILE_LIST=true         # file_list (cross-platform Node.js native, recursive + depth + pattern glob)
ENABLE_FILE_GREP=true         # grep (cross-platform native, recursive + -i + -n + glob + multiline)
ENABLE_RUN_TESTS=true        # run_tests (autodetect: bun/jest/vitest/pytest)
ENABLE_RUN_GATE=true         # run_gate (P5 — gate receipt: exit code THẬT + sha256 + stdout/stderr tail; targeted_test/full_test/lint/typecheck/diff_check/custom)
ENABLE_WORK_DATA=true        # work_data (P8 — CRUD dữ liệu công việc bảng AgentWorkData: active→completed/obsolete, bộ dọn tự động 7 ngày)
ENABLE_GIT_COMMIT=true        # git_commit (scoped paths + structured receipt — NO push)

# Phase 3 (code intelligence + MCP — implemented in Task 8; defaults false per
# spec Part 12 "new tools default false"; flip to true in .env to enable after
# smoke test passes; see docs/tool-smoke-tests.md for verification scenarios)
ENABLE_LSP_DIAGNOSTICS=true
ENABLE_BROWSER_SCREENSHOT=true
ENABLE_LINT=true
ENABLE_TYPE_CHECK=true
ENABLE_TEST_COVERAGE=true
ENABLE_DB_QUERY=true
ENABLE_MCP_CALL=true
# MCP server discovery: comma-separated list of MCP server IDs to auto-load.
# Built-in support: filesystem, github, postgres, puppeteer.
# Auto-discovers from ~/.config/mcp/servers.json if MCP_SERVERS is empty.
MCP_SERVERS=

# Phase 4 (process + safety + plan mode + cron — implemented in Task 10)
# All 6 flags default=false per spec Part 12 "new tools default false".
# Flip to true in .env to enable; see docs/FULLSTACK_CAPABILITY_PLAN_V2.md Phase 4.
# 4.1 — auto-checkpoint before risky ops (file_edit/file_delete/file_multi_edit/git_commit/run_tests)
ENABLE_AUTO_CHECKPOINT=false
# 4.2 — auto-restore on verify failure (off=skip | warn=console.warn only | strict=actually restore)
ENABLE_AUTO_RESTORE=off
# 4.3 — staging branch per workflow (code-team/<sessionId> — all edits land on staging, merged at end)
ENABLE_STAGING_BRANCH=false
# 4.4 — PendingEdits human review (high-risk ops create PendingEdit records, paused until user approves via /api/openclaw/pending-edits)
ENABLE_HUMAN_REVIEW=false
# 4.5 — exit_plan_mode tool (Claude Code parity — agent emits plan + target files + risk; workflow pauses for user approval via /api/openclaw/plan-mode)
ENABLE_PLAN_MODE=false
# 4.6 — cron tool (Z.ai Code parity — schedule recurring/one-time agent tasks via mini-service cron-scheduler on port 3004)
ENABLE_CRON_TOOL=false
# Optional overrides:
# STAGING_PARENT_BRANCH=main  # parent branch staging merges into (default 'main')
# CRON_AGENT_ENDPOINT=http://localhost:3000/api/openclaw/sessions  # default: cron tick loop calls this endpoint with {sessionId, task, agentId, source, jobId} to execute due jobs. Absolute URL needed (server-side fetch — relative paths fail).

# Phase 5 (Architecture Consolidation) — see docs/FULLSTACK_CAPABILITY_PLAN_V2.md Part 12
# 5.1 — Master orchestrator dispatches real agent steps (runAgentStep) instead of placeholder.
#       When false, startOrchestration() returns status='skipped' immediately.
ENABLE_MASTER_ORCHESTRATOR=false
# 5.2 — Agent delegator executes real sub-agent LLM calls (1 LLM + optional 1 tool + 1 synthesis).
#       When false, executeSubAgent() returns a fake placeholder result after 100ms.
ENABLE_REAL_DELEGATE=false
# 5.6 — Session Resume (Appendix C, lines 723-779):
#   When LLM context exceeds CONTEXT_OVERFLOW_THRESHOLD tokens,
#   workflow-engine.ts runAgentStep pauses the session (status='paused',
#   contextOverflowCount++) + serializes the state to WorkflowSession.state.
#   A new agent can then POST /api/workflow/resume?sessionId=X to acquire
#   the lock + re-inject original task + last 5 tool receipts + current step.
#   GĐ3 CI-3 B5 (auto-resume): overflow giờ chạy digest TRƯỚC — nén đủ thì
#   KHÔNG pause; không đủ thì pause + TỰ resume in-process (cùng code path
#   POST resume, tối đa WORKFLOW_MAX_AUTO_RESUME=3 lần/session, kèm stale-lock
#   recovery 30 phút). Không còn treo vĩnh viễn chờ API thủ công.
ENABLE_SESSION_RESUME=true
# 5.6 — Context overflow threshold in tokens (default 80000). Chars/4 estimator.
CONTEXT_OVERFLOW_THRESHOLD=80000
# CI-3 B5 — cap số lần auto-resume mỗi session khi digest không cứu được
#   overflow (vượt cap → pause thật chờ POST resume thủ công).
WORKFLOW_MAX_AUTO_RESUME=3
# CI-3 B5 — độ trễ (ms) trước khi auto-resume kích hoạt sau overflow pause.
WORKFLOW_AUTO_RESUME_DELAY_MS=2000
# CI-3 B7 — budget ký tự TỔNG của system prompt (goal-loop + workflow step +
#   TL checkpoint verify). Nhiều block ghép vào system prompt ngoài skills
#   (16k) / HOT (2k) / roster (8k) không có cap riêng → tổng có thể phình
#   30-50k chars. Vượt budget → cắt block priority thấp nhất (giữ đầu block +
#   marker "…[budget-cut x/y chars]"), block nhỏ <500 chars không cắt.
#   Đơn vị: ký tự (40000 ~ 10k tokens). 0 = KHÔNG giới hạn.
#   Đọc 1 lần lúc app khởi động (module-level).
#   Task D (token efficiency 2026-10-30): mirror .env live — hạ còn 40000 để
#   cắt system prompt thừa (~1-10k tok/vòng tùy agent).
SYSTEM_PROMPT_BUDGET_CHARS=40000

# Phase 4 SMOLAB — Retrieval quality suite (kb-access.ts searchChunks pipeline + searchEntitiesForUser)
# 3.7 — in-process BM25+RRF hybrid fusion over dense candidates (pure function, no collection migration)
ENABLE_HYBRID_SEARCH=true
# 3.8 — MMR diversity rerank (λ=0.7, uses pre-fetched Qdrant vectors — no re-embedding)
ENABLE_MMR=true
# 3.6 — external cross-encoder reranker client. Needs a rerank service running at RERANKER_ENDPOINT
#       (see src/lib/kb-routing/reranker.ts header for hosting bge-reranker-v2-m3 as a mini-service).
ENABLE_RERANKER=false
# 3.11 — semantic (vector) entity search with lexical fallback via per-label Neo4j vector indexes
ENABLE_SEMANTIC_ENTITY_SEARCH=true
# Optional — only needed when ENABLE_RERANKER=true:
# RERANKER_ENDPOINT=http://localhost:8080/rerank
# RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Phase 4 SMOLAB Task C — Query rewrite + HyDE (Prop 3.9)
# Rewrites the chat query (pronoun resolution via last 2 turns) + generates a HyDE hypothetical
# answer whose EMBEDDING is used as the dense search vector (see src/lib/kb-routing/query-rewriter.ts).
# Costs up to 3 LLM calls per query (+1-2s latency) — mitigated by a 200-entry / 10-min LRU cache.
# Default false (opt-in): flip to true when retrieval quality matters more than p95 latency.
ENABLE_QUERY_REWRITE=false

# Auth token cho /api/opencode/* + /api/workspace/* (middleware + opencode-server).
# BỎ TRỐNG = app TỰ SINH token ngẫu nhiên khi khởi động và lưu vào file
# .tmo-api-token (gitignored, mode 0600) — module Code hoạt động ngay không
# cần cấu hình tay. Token ổn định qua các lần restart.
# Đặt giá trị riêng nếu muốn kiểm soát (cookie/CLI dùng chung giá trị đó):
#   openssl rand -hex 24
TMO_API_TOKEN=

# ============================================
# CI-6 WORKSPACE & REPO PIPELINE (Mr. Architect request 2026-09-11)
# Quy trình Omega local: sửa trong TMO_DEFAULT_WORKSPACE → verify_and_push
# (lint→typecheck→tests→smoke→secret-scan→commit→push→pull) → pull verify.
# ============================================
# Kho chuẩn cho /api/git-pull + ensureDefaultWorkspace (remote origin)
# 2026-09-30 (round-12): kho ĐÚNG là nguyenquocviety2c-code/TMO (user-confirmed —
# vietnq130593-code/TMO là sai kho; account nguyenquocviety2c không tồn tại)
TMO_REPO_URL=https://github.com/nguyenquocviety2c-code/TMO
# Thư mục workspace mặc định — bootstrap lúc khởi động (mkdir + git init +
# remote origin + activate Workspace row). BỎ TRỐNG = không bootstrap.
# Máy local Mr. Architect: E:\APP\TMO-clone
TMO_DEFAULT_WORKSPACE=E:\APP\TMO-clone
# (2026-09-15 — user directive CLONE-FIRST) Thư mục clone chính thức để mọi
# chỉnh sửa/nâng cấp hệ thống thực hiện TRƯỚC (sửa → kiểm định lint/typecheck/
# tests → push GitHub → pull về hệ thống đang vận hành). Khi set, mọi agent
# thấy ghi chú "🔐 CLONE-FIRST WORKFLOW" trong workspace context + Omega điều
# phối team theo quy trình clone-first. Thường TRÙNG TMO_DEFAULT_WORKSPACE.
# Máy local Mr. Architect: E:\APP\TMO-clone
TMO_CLONE_DIR=E:\APP\TMO-clone
# Tự mở File Explorer mỗi khi workspace vừa được activate MỚI (không mở lại
# nếu đã active từ lần chạy trước) — Mr. Architect chọn phương án A
TMO_AUTO_OPEN_WORKSPACE=true
# GitHub PAT cho git_push/git_pull (fallback cuối; ưu tiên token store
# db/.github-token.json lưu qua dialog "Pull Code từ GitHub")
GITHUB_TOKEN=

# ─── AGENT PRIMARY MODEL + FALLBACK CHAIN (NGỪNG DÙNG — Task 33/37) ───
# ⚠ KHÔNG đặt 2 biến này trong .env! PHIÊN 7 (Task 37): TẤT CẢ agents chạy
# space-bunny-free (model free duy nhất mở cho oc_sk key). Mặc định code:
#   AGENT_PRIMARY_MODEL  = space-bunny-free
#   AGENT_FALLBACK_CHAIN = nemotron-3.5-lightning-free, mimo-v2.6-flash-free
#   (chỉ còn vai trò hiển thị health + model-switch DR-C7, không ảnh hưởng
#   call thật). Model THẬT của từng agent nằm trong DB — seed tự sync mỗi boot.
# AGENT_PRIMARY_MODEL=
# AGENT_FALLBACK_CHAIN=

# ─── LLM TIMEOUT + MODEL TIMEOUT-BREAKER (Task 22 + review R2-a) ───
# Timeout base mỗi attempt; timeout HIỆU DỤNG = max(base, maxTokens × ms/token)
# (LLM_TIMEOUT_MS_PER_TOKEN — output dài hợp lệ không bị strike đánh sập model).
LLM_TIMEOUT_MS=150000
LLM_TIMEOUT_MS_PER_TOKEN=12
# 2 timeout liên tiếp → circuit breaker block model 10 phút (fail-fast).
MODEL_TIMEOUT_STRIKES=2
MODEL_BLOCK_BREAKER_MS=600000

# ─── LLM MODEL HEALTH PROBER (Task 20 — 2026-09-03) ───
# Root-cause "chờ một lúc rồi Agents không tạo được output do LLM call thất bại":
# khi 3 lõi đầu chuỗi HANG phía NIM, chuỗi fallback phải đốt ~460s (3 × 150s
# timeout) trước khi tới lượt minimax-m3 — trong khi caller timeout ngoài
# (60-180s) giết chuỗi giữa chừng → minimax không bao giờ được gọi dù vẫn khỏe.
# Prober probe nền 6 lõi (kimi-k3 + 3 fallback + nemotron-550b + gpt-oss-120b)
# bằng request nhỏ 16 token mỗi 5 phút: lõi hang (0-byte timeout) → trip circuit
# breaker NGAY (call thật skip lõi đó trong ~ms → đi thẳng minimax ~1.5s); lõi
# hồi phục → xóa breaker NGAY (không đợi hết 10' window).
# Task 33: prober mặc định OFF — chỉ probe lõi NIM mà agents không còn dùng.
# Bật lại (khi quay về NIM cho LLM): LLM_MODEL_PROBER=true (code chỉ nhận
# 'true'; '1' cũng bị coi là TẮT).
LLM_MODEL_PROBER=0
LLM_PROBE_INTERVAL_MS=300000
# 90s/lõi — dư dả cho reasoning model khỏe; model cần >90s cho câu trả lời 16
# token là model chậm, block 10' là đúng chính sách latency-first.
LLM_PROBE_TIMEOUT_MS=90000
LLM_PROBER_BOOT_DELAY_MS=30000
# Outer timeout các caller (đã nâng mặc định 600s ≥ worst-case chuỗi ~460s —
# chỉ cần đặt nếu muốn chỉnh riêng):
# SD_LLM_TIMEOUT_MS=600000          # self-direction orchestrator
# SD_SCAN_LLM_TIMEOUT_MS=600000     # self-direction scan
# ALISTA_LLM_TIMEOUT_MS=600000      # alista proposals
# OMEGA_CONSULT_TIMEOUT_MS=600000   # omega consult
# DELEGATION_EVAL_TIMEOUT_MS=600000 # delegation evaluator
# AGENT_STEP_TIMEOUT_MS=600000      # code-team 1 step (mặc định mới 600s)
# CHECKPOINT_VERIFY_TIMEOUT_MS=300000 # code-team TL verify (mặc định mới 300s)

# ─── CODE TEAM SOP REQUEST (request_code_team tool) ───
ENABLE_CODE_TEAM_REQUEST=true
# Timeout tổng 1 lần gọi request_code_team (30' mặc định; 0 = ∞)
CODE_TEAM_REQUEST_TIMEOUT_MS=1800000
# Số workflow code team chạy đồng thời tối đa mỗi process (mặc định 1 — R2-c #1
# depth-guard + chống 2 full-team workflow đè RAM song song).
CODE_TEAM_MAX_CONCURRENT_REQUESTS=1
